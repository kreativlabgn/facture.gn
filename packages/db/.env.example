# Connexion runtime (client Prisma). En local = Postgres nu.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"

# Connexion directe pour le CLI Prisma (`migrate`, `db push`) — schema.prisma
# déclare `directUrl = env("DIRECT_URL")`, donc cette variable DOIT exister
# partout où une commande `prisma migrate` tourne, sinon Prisma échoue.
# En local / CI : identique à DATABASE_URL (pas de pooler).
# En prod (ADR-120) : la connexion DIRECTE Supabase (port 5432,
#   postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres), pendant que
#   DATABASE_URL pointe sur le pooler transaction (port 6543, ?pgbouncer=true).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"
