// Schéma Prisma — Trust Context (+ amorces Money / Capital / Platform)
//
// Référence métier : V/ERD-facture-gn.md + V/DAT-facture-gn.md §4. Le schéma a
// dépassé le bootstrap « 6 entités MVP » d'origine — il couvre aujourd'hui le
// cycle de vie facture complet (machine à états `invoice` : draft → issued →
// partially_paid → paid, + voided/converted/expired — DAT §4), l'audit
// append-only (`invoice_event`, garde trigger 20260830120000), la certification
// chaînée, les paiements/avoirs/remboursements, l'écosystème cabinet/CGA
// (professional_practice ── mandate ── organization) et le rapprochement bancaire.
//
// Conventions & divergences assumées vis-à-vis de l'ERD :
// - Colonnes en snake_case en base (@map), camelCase côté client Prisma.
// - InvoiceSequence : ajout (absent de l'ERD) — number sans trou par
//   organisation/année sous concurrence (Registre-ADR, Article 23 OHADA).
// - customer_id / branch_id / product_id / financed_by_partner_id /
//   recurring_template_id : de vraies relations FK, aucun scalaire orphelin.
//
// Isolation multi-tenant — Row-Level Security PostgreSQL (Prisma ne modélise PAS
// les policies : elles vivent dans les migrations SQL) :
// - 20260829150000_enable_row_level_security : politiques `org_isolation` par
//   ORGANISATION (GUC `app.current_org_id`), dormantes.
// - 20260905120000_rls_practice_scope : même politique étendue au scope PRACTICE
//   (GUC `app.current_practice_id` → organisations à mandat `active`, DAT §7.2).
// - Helpers : packages/db/src/rls.ts. Activation : docs/runbooks/rls-rollout.md
//   + packages/db/prisma/scripts/rls-activate-supabase.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url       : connexion runtime. En prod (ADR-120) = pooler Supabase en mode
  //             transaction (port 6543, ?pgbouncer=true → Prisma désactive les
  //             prepared statements). En local / CI = Postgres nu.
  // directUrl : connexion directe (port 5432), utilisée UNIQUEMENT par le CLI
  //             Prisma (`migrate`, `db push`) — jamais par le client applicatif.
  //             En local / CI, DIRECT_URL = DATABASE_URL (pas de pooler). Doit
  //             être défini partout où `prisma migrate` tourne : les trois
  //             .env.example, docker-compose.yml (services API), job CI `build`.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PreferredLanguage {
  fr
  pular
  malinke
  soussou
}

// Minuscules, comme tous les enums de ce schéma (RegimeFiscal, InvoiceStatus…).
enum DeviceStatus {
  // Jeton émis, terminal pas encore présenté.
  pending
  // Enrôlé : imeiOrSerial et publicKey connus, jeton consommé.
  active
  // Coupé — perte, vol, remplacement. Jamais supprimé : la traçabilité des
  // factures déjà émises par ce terminal doit rester lisible.
  revoked
}

enum BranchType {
  boutique
  entrepot
  agence
  en_ligne
}

enum RegimeFiscal {
  normal_tva
  tpu
  normal_sans_tva
  non_assujetti_association
}

enum LegalForm {
  commercial
  association
}

enum RegistrationSource {
  organic
  apip
  cga_referral
  fodip
  partner_3ae
  agent_terrain
}

// F11, ADR-077/078/082 — "APIP en premier lieu", seul type avec une intégration
// technique réelle (webhook signé). fodip/partner_3ae scaffoldés pour cohérence
// ERD mais "restent hors plateforme... aucune intégration technique" (ADR-078) —
// jamais de webhook réel pour ces deux-là dans cette story.
enum PartnerType {
  apip
  fodip
  partner_3ae
}

enum PartnerStatus {
  active
  suspended
  expired
}

model Partner {
  id            String        @id @default(uuid())
  type          PartnerType
  name          String
  conventionRef String?       @map("convention_ref")
  status        PartnerStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")

  @@map("partner")
}

enum FinancialPartnerType {
  banque
  mfi
}

enum FinancialPartnerStatus {
  active
  suspended
}

// K4/K5, ADR-089 — structurellement distincte de PARTNER (institutionnel léger :
// apip/fodip/partner_3ae) : une banque/MFI a des besoins différents (API dédiée,
// KYC, conditions de financement). apiKey présent pour fidélité à l'ADR, jamais
// lu ni écrit par aucun code de cette story — aucune intégration API réelle
// (même pattern que ApiKey.lastUsedAt, F15). Seuls banque/mfi sont couverts ici
// (MVP du financement B2G) — fournisseur_crediteur (ADR-100) reste V2, signalé
// comme un risque réglementaire non tranché, hors scope.
model FinancialPartner {
  id        String                 @id @default(uuid())
  name      String                 @unique
  type      FinancialPartnerType
  apiKey    String?                @map("api_key")
  status    FinancialPartnerStatus @default(active)
  createdAt DateTime               @default(now()) @map("created_at")

  financedInvoices Invoice[]

  @@map("financial_partner")
}

enum DgiVerificationStatus {
  unverified
  pending
  verified
}

enum CommercialTier {
  freemium
  starter
  // ADR-106 — 6e palier commercial, comblant le saut tarifaire entre Starter et
  // Pro (5 succursales / 7 collaborateurs). Le gap était documenté depuis H1
  // dans plan-features-grid.ts : « n'existe pas dans l'enum CommercialTier ».
  starter_plus
  pro
  enterprise
  custom
}

enum InvoiceDocumentType {
  invoice
  proforma
  quote
}

// Lot C, ADR-109 — marqueur de contexte de facturation B2G, posé explicitement
// (jamais dérivé de customer.isPublicEntity). marche_public : la facture entre
// dans un dossier de commande publique. Déclaratif, jamais bloquant — aucune
// règle n'exige reference_marche même en marche_public (ADR-090 : optionnel,
// cohérence vérifiée humainement par le DAF).
enum InvoiceCadre {
  standard
  marche_public
}

// Lot D — canal par lequel une facture a été émise. Posé exclusivement côté
// serveur par le chemin de code (2e argument de InvoicesService.createDraft),
// jamais depuis un DTO client (un appelant PWA pourrait mentir sur son canal).
// agent_terrain : aligné sur RegistrationSource.agent_terrain / User.isCommercialAgent
// (ADR-107). api : modélisé pour le futur (auth par clé API, F15) — aucun code
// ne le pose encore, même précédent que payment_link/bank_transfer avant câblage.
// ADR-108 — régime de saisie d'une ligne de facture. Décrit COMMENT le prix
// unitaire a été capturé, jamais ce qu'il vaut : les totaux de la facture sont
// scellés par la certification et ne dépendent pas de cette colonne.
//
// TTC_FIRST : convention historique du parcours marchand (PWA, USSD, agent
// terrain, récurrent). unit_price est TTC, et InvoicesService.createDraft()
// dérive HT/TVA du total par computeTaxBreakdown().
// HT_FIRST : standard international des ERP tiers, entré par la passerelle PDP
// (ADR-107). unit_price est HORS TAXES et la TVA est déclarée globalement par
// le connecteur ; PdpConsolidationService écrit les totaux DÉCLARÉS sans
// repasser par le normalisateur TTC — sans quoi le TTC certifié vaudrait le HT.
//
// VALEURS EN MAJUSCULES, seul enum du schéma dans ce cas : elles sont fixées
// telles quelles par l'ADR-108 et lues par le rendu PDF comme par le front.
// Les aligner en snake_case aurait divergé du texte approuvé.
enum SaisieRegime {
  TTC_FIRST
  HT_FIRST
}

enum EmissionChannel {
  pwa
  ussd
  agent_terrain
  api
}

// Une seule valeur aujourd'hui (C5) — enum plutôt que String brute pour rester
// cohérent avec tous les autres champs discriminants de ce schema (RegimeFiscal,
// InvoiceDocumentType, InvoiceStatus, PaymentMethod), et pour qu'une future
// distinction arrhes/acompte (mentionnée par ADR-034, non construite ici) ne puisse
// pas introduire une valeur mal orthographiée qui échapperait silencieusement aux
// filtres depositType="arrhes" déjà en place.
enum DepositType {
  arrhes
}

// 7 valeurs — DAT §4 : invoice.status
// Transmission unitaire d'une facture au guichet e-TVA (LFI 2025). Distinct du
// statut de la facture : une facture parfaitement émise et payée peut n'avoir
// jamais été transmise, et l'inverse n'existe pas.
enum EtaxTransmissionStatus {
  // Mise en file, la DGI n'a pas encore acquitté.
  pending
  // Acquittée : etax_receipt_number porte le reçu officiel.
  transmitted
  // Backoff épuisé, ou refus définitif du guichet. La facture reste ÉMISE et
  // valide — un échec de télétransmission n'annule aucune certification. Cette
  // valeur existe pour le rattrapage, pas pour bloquer le commerçant.
  failed
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  voided
  converted
  expired
}

enum DisputeStatus {
  none
  disputed
  resolved
}

// 24 types confirmés au périmètre MVP/V1 (DAT §4.1 / ERD note de lecture) +
// liquidation_validated (J1, avancé en V1) et financing_disbursed (K4/K5).
// service_fait_confirmed (Niveau 1 B2G optionnel, ADR-098) reste seul exclu tant
// que le reste du B2G Context au-delà du Niveau 2 n'est pas scaffoldé.
// cash pour C1 (ce plan) ; payment_link (C2, orchestrateur Djomy/Moneroo) et
// bank_transfer (C3) sont des stories séparées — l'enum couvre les 3 valeurs de
// l'ERD par cohérence long terme, mais seul "cash" est accepté par le DTO/service
// actuel (docs/plans/2026-08-08-cash-payment-with-proof.md).
enum PaymentMethod {
  cash
  payment_link
  bank_transfer
}

enum PaymentStatus {
  pending
  completed
  failed
}

// G3, ADR-091 — échelle de conséquences à 4 niveaux, jamais punitive au premier
// signal. none→level_1→level_2 : escalade automatique meilleur-effort (voir
// CommissionBypassEscalationService). level_3/level_4 : exigent une action
// explicite Squad Money (aucun OrganizationRole ne représente ce périmètre,
// même précédent que DgiVerificationAuthGuard) — jamais posés automatiquement.
enum CommissionBypassLevel {
  none
  level_1_nudged
  level_2_proof_threshold_lowered
  level_3_under_review
  level_4_restricted
}

enum CommissionBypassCaseStatus {
  pending
  dismissed
  restricted
}

enum InvoiceEventType {
  cancellation_indemnity
  no_show_forfeited
  dispute_raised
  dispute_resolved
  payment_reminder_sent
  payment_link_generated
  payment_link_expired
  payment_link_regenerated
  invoice_voided
  invoice_converted
  overpayment_recorded
  refund_issued
  suspicious_cash_pattern_detected
  stale_invoice_detected
  mandate_requested
  mandate_granted
  mandate_revoked
  mandate_expired
  revenue_share_credited
  regime_change
  delegated_key_tier_changed
  validation_revoked
  // J1, ADR-080/081/098 — Niveau 2 de la chaîne de validation B2G, avancé en V1.
  // Ne constate JAMAIS le paiement effectif ni l'ordonnancement Trésor — voir
  // PublicBuyerPortalService.validateLiquidation().
  liquidation_validated
  // K4/K5, ADR-088/089 — Rail A choisi (avance FINANCIAL_PARTNER). Jamais émis
  // pour le Rail B (ADR-088 : "la PME n'utilise aucun financement", absence
  // d'action, jamais un événement).
  financing_disbursed
  // Transmission unitaire e-TVA (LFI 2025). L'acquittement de la DGI et son
  // échec sont tous deux journalisés : le journal WORM doit retracer ce que
  // l'administration a reçu, pas seulement ce qu'on a certifié.
  etax_transmitted
  etax_transmission_failed
}

model User {
  id                String            @id @default(uuid())
  name              String
  passwordHash      String?           @map("password_hash")
  preferredLanguage PreferredLanguage @default(fr) @map("preferred_language")
  createdAt         DateTime          @default(now()) @map("created_at")

  // ADR-045, B5, ADR-107 — flag plateforme, indépendant de tout OrganizationRole
  // (les 7 rôles existants sont tous scopés à une organisation). Nommage aligné
  // ADR-107 : distingue explicitement l'Agent commercial terrain (persona facture.gn,
  // ce flag) du rôle RBAC OrganizationRole.field_agent (personnel de la PME,
  // assisted_session sur une organisation déjà existante — jamais ce flag). Accordé
  // exclusivement via un endpoint interne dédié (CommercialAgentAuthGuard, secret
  // propre — jamais confondu avec MONEY_API_INTERNAL_KEY ni DGI_VERIFICATION_INTERNAL_KEY).
  isCommercialAgent Boolean @default(false) @map("is_commercial_agent")

  // Canal USSD *620# (D2, Spec USSD §3) — distinct de passwordHash (PWA/agent).
  // Nullable : créé au premier accès *620# (décision utilisateur), jamais
  // depuis la PWA. pinFailedAttempts/pinLockedUntil : 3 essais puis blocage
  // 30 min (§3.3), voir ussd-auth.service.ts.
  pinHash           String?   @map("pin_hash")
  pinFailedAttempts Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until")

  phones                        UserPhone[]
  invoiceEvents                 InvoiceEvent[]
  memberships                   OrganizationMember[]
  recoveryRequestsMade          AccountRecoveryRequest[]   @relation("RecoveryRequester")
  recoveryRequestsResolved      AccountRecoveryRequest[]   @relation("RecoveryResolver")
  creditLimitRequestsMade       CreditLimitChangeRequest[] @relation("CreditLimitRequester")
  creditLimitRequestsResolved   CreditLimitChangeRequest[] @relation("CreditLimitResolver")
  assistedSessions              AssistedSession[]
  practiceMemberships           PracticeMember[]
  mandatesGranted               Mandate[]
  publicBuyerAccountMemberships PublicBuyerAccountMember[]
  apiKeysCreated                ApiKey[]                   @relation("ApiKeyCreator")
  apiKeysRevoked                ApiKey[]                   @relation("ApiKeyRevoker")
  devicesProvisioned            Device[]                   @relation("DeviceProvisioner")
  devicesRevoked                Device[]                   @relation("DeviceRevoker")
  creditTransactions            CreditTransaction[]
  pendingMemberInvitesSent      PendingMemberInvite[]      @relation("PendingMemberInviteInviter")
  pendingMemberInvitesResolved  PendingMemberInvite[]      @relation("PendingMemberInviteResolvedUser")
  fiscalPeriodClosingsMade      FiscalPeriodClosing[]
  bankTransactionsImported      BankTransaction[]          @relation("BankTransactionImporter")
  bankTransactionsResolved      BankTransaction[]          @relation("BankTransactionResolver")

  @@map("user")
}

// Security Audit 2026-08-23, finding #14 — capacité MINIMALE de révocation
// immédiate d'un JWT compromis (ex. POST /auth/logout). CE N'EST PAS un système
// de refresh token rotatif (hors scope de ce correctif, chantier séparé) : le
// token reste un access token classique signé RS256/TTL 12h (auth-token.service.ts,
// inchangé), simplement vérifié contre cette liste à chaque requête. expiresAt
// recopie l'expiration du JWT lui-même — permet un nettoyage périodique des lignes
// devenues sans objet (aucun job de purge construit ici, même limite déjà
// documentée pour UssdSession).
model RevokedToken {
  jti       String   @id
  revokedAt DateTime @default(now()) @map("revoked_at")
  expiresAt DateTime @map("expires_at")

  // J3 — index du prédicat de purge (RetentionService).
  @@index([expiresAt])
  @@map("revoked_token")
}

// 7 rôles organisationnels de base (ADR-027, MVP initial). accountant_external et
// practice_admin (portant le MVP à 9, ADR-070) ne sont volontairement pas inclus ici :
// ils dépendent du mécanisme de mandat cabinet/CGA (PROFESSIONAL_PRACTICE/MANDATE)
// non scaffoldé — voir docs/plans/2026-08-08-auth-rbac-org-roles.md.
enum OrganizationRole {
  owner
  admin
  accountant_internal
  cashier
  field_agent
  delivery_driver
  client_portal
  // G4, ADR-097 — lecture seule stricte du journal d'audit (invoice_event),
  // aucune permission d'écriture, aucune exception.
  auditor
  // E5, ADR-083 — seul rôle habilité à résoudre une CreditLimitChangeRequest
  // (jamais owner/admin en substitut, "jamais une décision unilatérale"). ADR-083
  // le note déjà lui-même : "jusqu'ici défini sans cas d'usage concret au-delà
  // d'un intitulé générique" — reçoit ici son premier contenu fonctionnel réel.
  approver
  // F14, ADR-104 — renommé depuis dgi_readonly pour lever l'ambiguïté "facture.gn
  // n'est jamais une autorité d'État" (positionnement non négociable). Lecture
  // seule stricte (factures + export FEC), invité par l'organisation elle-même —
  // aucun rapport avec la persona institutionnelle DGI nationale (ADR-079).
  tax_controller_readonly
  // F15, ADR-097 — gestion self-service des clés API (génération/révocation) et
  // consultation des logs d'appels. Seule la gestion des clés est construite ici
  // (voir PLAN "Alternatives écartées") — l'authentification par clé API elle-même
  // et les logs restent un chantier distinct, non résolu.
  developer_api
  // E10, ADR-097 — mouvements de stock (réception/ajustement/perte) par
  // succursale, jamais le catalogue produit lui-même (réservé owner/admin).
  // Ne voit jamais cost_price (ADR-084, territoire business_manager).
  inventory_manager
  // F3, DAT §3.5 — "proche/assistant", accès délégué invitable depuis *620#
  // (OrganizationsService/UssdAccountService.inviteViewer()) ET depuis la PWA
  // (inviteMember() générique, F14/H1). Lecture seule stricte des factures
  // (invoices.controller.ts, même trio que tax_controller_readonly) — aucune
  // autre permission dédiée n'existe pour ce rôle (DAT §3.4, catalogue
  // inchangé), portée volontairement minimale faute d'acceptance criteria plus
  // détaillés dans le Backlog.
  viewer
}

// F15, ADR-097 — distingue les clés de test (sandbox) des clés live, cohérent
// avec le label affiché ("fg_live_••••9f2a" / "fg_test_••••") — openapi
// ApiKey/ApiKeyCreated.
enum ApiKeyEnvironment {
  production
  sandbox
}

// F15, ADR-097 — secret jamais stocké en clair (keyHash, argon2id via
// PasswordService, même primitive que les mots de passe). keySuffix : 4
// derniers caractères du secret en clair, conservés pour permettre à
// l'utilisateur de reconnaître sa clé dans la liste sans jamais exposer le
// secret complet après sa création. lastUsedAt inclus pour compatibilité avec
// le schéma openapi déjà publié, mais jamais renseigné par aucun code de cette
// story (aucun mécanisme d'authentification par clé construit ici) — restera
// null jusqu'à une story future.
model ApiKey {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  environment     ApiKeyEnvironment
  keyHash         String            @map("key_hash")
  keySuffix       String            @map("key_suffix")
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  revokedAt       DateTime?         @map("revoked_at")
  revokedByUserId String?           @map("revoked_by_user_id")
  lastUsedAt      DateTime?         @map("last_used_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User         @relation("ApiKeyCreator", fields: [createdByUserId], references: [id])
  revokedByUser User?        @relation("ApiKeyRevoker", fields: [revokedByUserId], references: [id])
  // ADR-107 — les dépôts PDP faits AVEC cette clé. Même intention que
  // createdByUserId juste au-dessus : sur une organisation branchée à plusieurs
  // connecteurs (ERP comptable + caisse), savoir LEQUEL a déposé quoi est la
  // première question du support. onDelete: Restrict côté PdpRawTransaction —
  // une clé révoquée reste en base, la trace de ce qu'elle a déposé ne doit
  // jamais pouvoir disparaître avec elle.
  pdpRawTransactions PdpRawTransaction[]

  @@map("api_key")
}

// E5, ADR-083 — même pattern qu'AccountRecoveryRequest (pending/approved/rejected,
// resolvedByUserId/resolvedAt, transaction updateMany pour la sécurité de
// concurrence) : approbation obligatoire d'une hausse de credit_limit au-delà
// du seuil configuré (Organization.creditLimitApprovalThreshold). Une baisse,
// ou une hausse sous le seuil, ne passe jamais par cette table — appliquée
// directement par CustomersService.proposeCreditLimit().
enum CreditLimitChangeStatus {
  pending
  approved
  rejected
}

model CreditLimitChangeRequest {
  id                String                  @id @default(uuid())
  customerId        String                  @map("customer_id")
  organizationId    String                  @map("organization_id")
  requestedByUserId String                  @map("requested_by_user_id")
  // Snapshot de creditLimit au moment de la demande — jamais recalculé après
  // coup, pour que la demande reste lisible même si le client a changé entre
  // temps (même principe que CommissionGridEntry, cost_price/ADR-084).
  currentLimit      BigInt?                 @map("current_limit")
  requestedLimit    BigInt                  @map("requested_limit")
  status            CreditLimitChangeStatus @default(pending)
  requestedAt       DateTime                @default(now()) @map("requested_at")
  resolvedAt        DateTime?               @map("resolved_at")
  resolvedByUserId  String?                 @map("resolved_by_user_id")

  customer        Customer     @relation(fields: [customerId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
  requestedByUser User         @relation("CreditLimitRequester", fields: [requestedByUserId], references: [id])
  resolvedByUser  User?        @relation("CreditLimitResolver", fields: [resolvedByUserId], references: [id])

  @@map("credit_limit_change_request")
}

// Le rôle n'est jamais mis en cache dans le JWT (voir AuthTokenService) : toujours
// résolu ici à la requête, pour qu'une révocation (revokedAt) soit effective
// immédiatement plutôt qu'à l'expiration du token.
model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at")
  revokedAt      DateTime?        @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_member")
}

model UserPhone {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  msisdn     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_phone")
}

// F13, ADR-096/ADR-108 — OTP à 4 chiffres pour le canal PWA du portail client
// (*620# reste sur le PIN direct existant, UssdAuthService, non concerné). Pas
// de FK vers User/UserPhone : le numéro peut être totalement inconnu du repo au
// moment de la demande (auto-inscription, ADR-096 "aucune invitation préalable
// requise") — la résolution/création d'identité n'a lieu qu'à la vérification
// réussie. consumedAt marqué via updateMany+where (anti-rejeu, même pattern que
// les autres transitions d'état à garde de concurrence de ce repo).
model ClientPortalOtp {
  id         String    @id @default(uuid())
  msisdn     String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([msisdn])
  // J3 — index du prédicat de purge (RetentionService).
  @@index([expiresAt])
  @@map("client_portal_otp")
}

enum RecoveryStatus {
  pending
  approved
  rejected
}

// ADR-042, B3 — "backup admin obligatoire" est un nudge, jamais un blocage
// (cohérent avec B1/B4, inscription jamais bloquée) : aucun champ de désignation
// dédié, n'importe quel OrganizationMember owner/admin non révoqué de
// l'organisation ciblée joue ce rôle au moment de la résolution.
model AccountRecoveryRequest {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  organizationId   String         @map("organization_id")
  status           RecoveryStatus @default(pending)
  requestedAt      DateTime       @default(now()) @map("requested_at")
  resolvedAt       DateTime?      @map("resolved_at")
  resolvedByUserId String?        @map("resolved_by_user_id")

  user           User         @relation("RecoveryRequester", fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  resolvedByUser User?        @relation("RecoveryResolver", fields: [resolvedByUserId], references: [id])

  @@map("account_recovery_request")
}

model Organization {
  id                           String                @id @default(uuid())
  name                         String
  regimeFiscal                 RegimeFiscal          @map("regime_fiscal")
  legalForm                    LegalForm             @map("legal_form")
  // Nullable : NIF optionnel à l'inscription (ADR-035, story B4 — self-service
  // jamais bloqué par une information que la PME n'a pas encore). Plusieurs
  // organisations sans NIF n'entrent jamais en conflit : Postgres autorise
  // plusieurs NULL sur une colonne @unique (même pattern qu'Invoice.number).
  nif                          String?               @unique
  // @unique, comme le NIF juste au-dessus, et pour la même raison : une
  // organisation = un identifiant fiscal chez l'État. Sans cette contrainte,
  // une redélivraison du webhook APIP (ADR-016) ou deux saisies assistées
  // concurrentes créeraient deux organisations pour la MÊME entreprise, chacune
  // avec sa séquence de factures et sa chaîne de certification — une scission
  // irréparable a posteriori. Nullable : plusieurs NULL restent autorisés par
  // Postgres, le self-service sans identifiant fiscal n'est jamais bloqué (B4,
  // ADR-035).
  etaxNumber                   String?               @unique @map("etax_number")
  // @unique — le RCCM est l'identifiant du registre du commerce, l'autre clé
  // naturelle du guichet SYNERGUI-SAFIG 2. C'est sur lui que porte la seconde
  // branche d'idempotence de createFromApip() : APIP peut redélivrer un
  // company-created dont le NIF a changé entre-temps alors que le RCCM, lui,
  // est immuable.
  rccm                         String?               @unique
  registrationSource           RegistrationSource    @default(organic) @map("registration_source")
  dgiVerificationStatus        DgiVerificationStatus @default(unverified) @map("dgi_verification_status")
  // D4, §4 Spec USSD — nécessaire pour "T1+90j" (velocity_tier). Posé au
  // moment de la transition vers verified (organizations.service.ts:verifyDgi).
  dgiVerifiedAt                DateTime?             @map("dgi_verified_at")
  bankAccountDetails           Json?                 @map("bank_account_details")
  // Portefeuille de crédits, en centimes GNF. DÉNORMALISATION ASSUMÉE : la
  // vérité est le registre credit_transaction, ce champ n'en est que la somme,
  // écrite dans la MÊME transaction que chaque mouvement. Sans lui, chaque envoi
  // de SMS exigerait un SUM() sur tout l'historique de l'organisation.
  // CreditsService.reconcile() permet de le recalculer depuis le registre.
  creditBalanceCentimes        BigInt                @default(0) @map("credit_balance_centimes")
  // Code de parrainage, généré à la demande — null tant que l'organisation n'a
  // pas activé le programme. @unique : c'est lui qui rattache un filleul, une
  // collision enverrait la prime au mauvais parrain.
  referralCode                 String?               @unique @map("referral_code")
  preferredLanguage            PreferredLanguage     @default(fr) @map("preferred_language")
  chiffreAffairesBrutDeclare   BigInt                @default(0) @map("chiffre_affaires_brut_declare")
  paymentLinkAutoSend          Boolean               @default(true) @map("payment_link_auto_send")
  commercialTier               CommercialTier        @default(freemium) @map("commercial_tier")
  createdAt                    DateTime              @default(now()) @map("created_at")
  // Nullable : seules les organisations inscrites via le Chemin B (assisté, B5)
  // en ont un — ADR-046/047, 8 caractères Base32, vérification de collision à la
  // génération (voir organizations.service.ts:createAssisted).
  accountCode                  String?               @unique @map("account_code")
  // Nullable — null = jamais gelé ou gel expiré (comparé à now() à la lecture,
  // aucun nettoyage actif nécessaire). Posé par AuthService.resolveRecovery()
  // sur une récupération de compte owner approuvée (B3), lu par
  // InvoicesService.issue() (G2, réinterprété — voir plan
  // freeze-after-account-recovery : ni PIN ni "plafond" n'existent dans ce repo).
  paymentsFrozenUntil          DateTime?             @map("payments_frozen_until")
  // E5, ADR-083 — seuil au-delà duquel une HAUSSE de credit_limit exige une
  // validation approver. Nullable : pas de CONFIG_PARAMETER générique dans ce
  // repo (ADR-058 jamais scaffoldée, même choix déjà accepté que
  // commission-grid.ts/ADR-074 et tax-regime.ts/C4) — null retombe sur
  // DEFAULT_CREDIT_LIMIT_APPROVAL_THRESHOLD (credit-limit-approval.ts).
  creditLimitApprovalThreshold BigInt?               @map("credit_limit_approval_threshold")

  // G3, ADR-091 — état d'escalade courant, jamais recalculé rétroactivement.
  commissionBypassLevel CommissionBypassLevel @default(none) @map("commission_bypass_level")
  // G3, ADR-091 — Niveau 2 : seuil de preuve photo/GPS/signature abaissé pour
  // CETTE organisation uniquement. Nullable : null = pas d'override, retombe
  // sur CASH_PROOF_THRESHOLD_GNF_CENTIMES (même précédent que
  // creditLimitApprovalThreshold ci-dessus, pas de CONFIG_PARAMETER générique).
  commissionBypassProofThresholdOverrideGnf BigInt? @map("commission_bypass_proof_threshold_override_gnf")

  invoices              Invoice[]
  sequences             InvoiceSequence[]
  members               OrganizationMember[]
  recoveryRequests      AccountRecoveryRequest[]
  assistedSessions      AssistedSession[]
  mandates              Mandate[]
  customers             Customer[]
  branches              Branch[]
  signingKeys           OrganizationSigningKey[]
  creditLimitRequests   CreditLimitChangeRequest[]
  apiKeys               ApiKey[]
  products              Product[]
  revenueShareCredits   RevenueShareCredit[]
  recurringTemplates    RecurringInvoiceTemplate[]
  commissionBypassCases CommissionBypassCase[]
  pendingMemberInvites  PendingMemberInvite[]
  fiscalPeriodClosings  FiscalPeriodClosing[]
  bankTransactions      BankTransaction[]
  creditTransactions    CreditTransaction[]
  referralsMade         Referral[]                 @relation("ReferralReferrer")
  referralReceived      Referral?                  @relation("ReferralReferred")
  devices               Device[]
  pdpRawTransactions    PdpRawTransaction[]

  @@map("organization")
}

// A3, ADR-026 — "clé racine Ed25519 en HSM, jamais exportée". encryptedPrivateKey :
// chiffrement enveloppe AES-256-GCM (envelope-encryption.ts) avec
// CERTIFICATION_MASTER_KEY — jamais en clair au repos, jamais journalisé.
// Approximation MVP honnête d'un vrai HSM cloud (aucun SDK Vault/KMS dans ce
// repo) — même posture déjà documentée pour CERTIFICATION_PRIVATE_KEY (TODO
// ADR-026/A3 dans certification.module.ts).
//
// E3 (ADR-114 provisoire, DAT §Crypto "rotation 365j") — N lignes par
// organisation dans le temps. AU PLUS UNE active : index unique partiel
// organization_signing_key_one_active_per_org (WHERE retired_at IS NULL AND
// revoked_at IS NULL). retiredAt = clé remplacée par rotation ; retrait ≠
// révocation : une clé retirée (non révoquée) reste valide pour les factures
// signées pendant qu'elle était active — verifyWithKey() suit Invoice.signingKeyId,
// jamais "la clé courante". Une facture déjà signée n'est JAMAIS re-vérifiée
// différemment.
model OrganizationSigningKey {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  publicKey           String    @map("public_key")
  encryptedPrivateKey String    @map("encrypted_private_key")
  createdAt           DateTime  @default(now()) @map("created_at")
  // E3 — posé par rotate() sur la clé sortante. NULL = pas remplacée.
  retiredAt           DateTime? @map("retired_at")

  // A4, ADR-025 — "révocation jamais rétroactive" : ne bloque JAMAIS
  // verifyWithKey() (intégrité des factures déjà signées), uniquement
  // certifyForOrganization() (nouvelles signatures) et le champ public
  // keyValidAtIssuance (VerificationService).
  revokedAt DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]

  @@index([organizationId])
  @@map("organization_signing_key")
}

// ADR-045, B5, ADR-107 — trace de l'inscription assistée par l'Agent commercial
// terrain. Jamais de membership pour l'agent lui-même (commercialAgentUserId n'est
// PAS dans OrganizationMember) : cette table EST la seule preuve du lien
// agent↔organisation. consentRecordedAt (jamais un booléen simple) — horodatage du
// consentement explicitement recueilli, cohérent avec le reste du schema
// (resolvedAt, revokedAt...). Nommage aligné ADR-107 : sans rapport avec
// OrganizationRole.field_agent (personnel de la PME).
model AssistedSession {
  id                String   @id @default(uuid())
  commercialAgentUserId String   @map("commercial_agent_user_id")
  organizationId    String   @map("organization_id")
  consentRecordedAt DateTime @map("consent_recorded_at")
  // Security Audit 2026-08-23, finding #8 — jusqu'ici aucun champ d'expiration ni
  // de révocation : un agent conservait indéfiniment la capacité d'émettre de
  // vraies factures certifiées au nom de l'organisation, même après la fin de sa
  // mission. TTL de 90 jours arbitraire (aucune spec ADR/Backlog ne fixe de durée),
  // ajustable en un point unique (voir ASSISTED_SESSION_TTL_MS). revokedAt permet
  // en plus une révocation manuelle immédiate par un owner/admin de l'organisation.
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  commercialAgent User         @relation(fields: [commercialAgentUserId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@map("assisted_session")
}

// F10, ADR-068/ADR-096 — comble le trou explicitement laissé "hors scope" par F8
// (PracticesService.inviteMember) et F14 (OrganizationsService.inviteMember) :
// les deux résolvent l'invité par UserPhone et échouent si le numéro n'a aucun
// compte facture.gn. organizationId/practiceId mutuellement exclusifs (une seule
// cible par invitation, jamais les deux) — imposé au niveau base par une
// contrainte CHECK dédiée (pending_member_invite_xor_target_check,
// 20260823160000), même précédent que invoice_conversion_requires_proforma_check
// (20260809130000) : au-delà de la vérification applicative à ses deux seuls
// points d'écriture actuels. Au plus une invitation VIVANTE par (msisdn, cible)
// également garanti au niveau base (index uniques partiels, même migration,
// même précédent que payment_one_arrhes_per_invoice) — revue post-fix #1, une
// fenêtre de course applicative permettait deux invitations concurrentes sur le
// même numéro. role en String (pas un enum Prisma) : OrganizationRole et
// PracticeMemberRole sont deux enums disjoints, validé côté service contre le
// bon enum selon la cible — même compromis déjà accepté pour UssdSession.state
// (typage TypeScript uniquement). expiresAt : leçon apprise deux fois cette
// session (AssistedSession puis Mandate ont eu ce champ scaffoldé sans jamais
// être appliqué à la lecture) — voir
// pending-member-invite.service.ts::resolveForNewUser(), filtré dès la
// première version. TTL 14 jours arbitraire (aucune spec ne fixe de durée),
// ajustable en un point unique (PENDING_MEMBER_INVITE_TTL_MS).
model PendingMemberInvite {
  id              String    @id @default(uuid())
  msisdn          String
  role            String
  organizationId  String?   @map("organization_id")
  practiceId      String?   @map("practice_id")
  invitedByUserId String    @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  resolvedUserId  String?   @map("resolved_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Fix minor-followups 2026-08-24 — organizationId/practiceId sont des FK
  // optionnelles : onDelete: SetNull explicite pour s'aligner sur le pattern
  // du reste du schema pour toute FK optionnelle (Customer.possibleDuplicateOf,
  // Mandate.grantedBy, CreditLimitChangeRequest.resolvedByUserId...) — la
  // migration initiale (20260823150000) les avait à tort en RESTRICT, copié du
  // pattern des FK organizationId/practiceId REQUISES d'AssistedSession/Mandate/
  // PracticeMember/OrganizationMember, seul cas où RESTRICT est correct dans ce
  // schema. Aucune fonctionnalité de suppression d'organisation/cabinet
  // n'existe aujourd'hui (impact pratique nul), mais RESTRICT bloquerait à
  // tort cette suppression future à cause d'une invitation même déjà
  // résolue/expirée/révoquée et jamais purgée.
  //
  // Revue post-fix #1 (20260824110000) — SetNull seul NE suffisait PAS : la
  // contrainte CHECK pending_member_invite_xor_target_check imposait alors
  // EXACTEMENT un des deux champs non-nul, donc (organizationId: null,
  // practiceId: null) après un SET NULL violait le CHECK et bloquait quand
  // même toute suppression. Le CHECK a été assoupli en "jamais les deux à la
  // fois" (20260824110000) pour tolérer ce (null, null) comme état terminal
  // légitime, et resolveForNewUser() (pending-member-invite.service.ts) gère
  // désormais explicitement ce cas.
  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  practice      ProfessionalPractice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  invitedByUser User                  @relation("PendingMemberInviteInviter", fields: [invitedByUserId], references: [id])
  resolvedUser  User?                 @relation("PendingMemberInviteResolvedUser", fields: [resolvedUserId], references: [id])

  @@index([msisdn])
  // J3 — index du prédicat de purge (RetentionService : acceptedAt IS NULL + expiresAt).
  @@index([acceptedAt, expiresAt])
  @@map("pending_member_invite")
}

// Compteur atomique par organisation/année — support de la numérotation
// séquentielle sans trou (OHADA Article 23). Absent de l'ERD de référence,
// ajouté pour rendre l'invariant applicable sous concurrence (cf. PLAN Tâche 10).
model InvoiceSequence {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  year           Int
  lastNumber     Int    @default(0) @map("last_number")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year])
  @@map("invoice_sequence")
}

// E1, ADR-037 — "branch sous organization, number jamais par branche" :
// InvoiceSequence reste clé par [organizationId, year] uniquement, jamais par
// branche — aucun changement requis là, cet invariant est déjà natif.
// Enrôlement matériel — terminaux physiques (caisses, smartphones) émettant des
// factures certifiées.
//
// DEUX SECRETS DE NATURE OPPOSÉE, à ne jamais confondre :
//   • `enrollmentTokenHash` — secret que la PLATEFORME émet et que le terminal
//     présente une fois pour s'enrôler. Haché (argon2id), jamais stocké en clair :
//     même discipline qu'ApiKey.keyHash, et pour la même raison — une fuite de la
//     table ne doit pas permettre d'enrôler un terminal pirate.
//   • `publicKey` — clé PUBLIQUE de l'enclave du terminal. Publique par nature :
//     stockée telle quelle, c'est elle qui permettra de vérifier ce que le
//     terminal signe. La clé privée ne quitte jamais l'enclave et n'est donc
//     JAMAIS reçue ni stockée ici.
//
// `imeiOrSerial` est @unique GLOBALEMENT, pas par organisation : un terminal
// physique n'existe qu'une fois au monde. Deux organisations ne peuvent pas
// enrôler le même appareil — c'est précisément ce qu'on veut empêcher (revente,
// vol, double émission). Conséquence assumée : l'unicité se heurte au RLS à
// l'insertion (voir DevicesService.enroll pour le traitement du conflit).
model Device {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  // Nullable : un terminal peut être enrôlé au niveau de l'organisation avant
  // d'être affecté à une succursale précise.
  branchId       String?      @map("branch_id")
  label          String
  imeiOrSerial   String       @unique @map("imei_or_serial")
  // Clé publique de l'enclave, en clair (Text) — voir l'en-tête du modèle.
  publicKey      String?      @map("public_key")
  status         DeviceStatus @default(pending)

  // Jeton d'association à usage unique : haché, à durée de vie courte, consommé
  // au premier enrôlement réussi (consumedAt) — jamais rejouable.
  enrollmentTokenHash String    @map("enrollment_token_hash")
  tokenExpiresAt      DateTime  @map("token_expires_at")
  tokenConsumedAt     DateTime? @map("token_consumed_at")

  provisionedByUserId String    @map("provisioned_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  enrolledAt          DateTime? @map("enrolled_at")
  revokedAt           DateTime? @map("revoked_at")
  revokedByUserId     String?   @map("revoked_by_user_id")

  organization      Organization @relation(fields: [organizationId], references: [id])
  branch            Branch?      @relation(fields: [branchId], references: [id])
  provisionedByUser User         @relation("DeviceProvisioner", fields: [provisionedByUserId], references: [id])
  revokedByUser     User?        @relation("DeviceRevoker", fields: [revokedByUserId], references: [id])

  // Le tunnel d'enrôlement cherche par empreinte de jeton, jamais par id.
  @@index([enrollmentTokenHash])
  @@index([organizationId, status])
  @@map("device")
}

// Registre des mouvements de crédits — la VÉRITÉ du portefeuille.
//
// Un registre et non un simple solde : sans lui, personne ne peut répondre à
// « pourquoi mon solde a baissé ». Même discipline qu'InvoiceEvent (ADR-015) :
// append-only, jamais modifié ni supprimé. Organization.creditBalanceCentimes
// en est la somme dénormalisée, écrite dans la même transaction.
//
// L'UNITÉ EST LE CENTIME GNF, comme partout ailleurs dans ce schéma — pas un
// « crédit » abstrait. Un jeton maison aurait imposé un taux de change interne
// à maintenir et à expliquer ; ici 1 crédit = 1 GNF, et le portefeuille est
// lisible sans conversion. Le pack commercial (100 SMS pour 30 000 GNF) reste
// une façon de VENDRE, pas une unité de compte.
model CreditTransaction {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  type           CreditTransactionType
  // Signé : positif pour un achat ou un remboursement, négatif pour une
  // consommation. La somme de la colonne EST le solde — aucune règle de signe
  // à réappliquer à la lecture, aucune erreur d'interprétation possible.
  amountCentimes BigInt                @map("amount_centimes")
  // Solde APRÈS ce mouvement, figé. Rend chaque ligne du relevé lisible seule,
  // et permet de détecter une dérive du solde dénormalisé sans rejouer tout
  // l'historique.
  balanceAfterCentimes BigInt           @map("balance_after_centimes")
  // Ce qui a été consommé ou vendu, en clair : « Relance SMS facture FG-… »,
  // « Pack 100 SMS ». Jamais un code technique — c'est un relevé de compte.
  label          String
  // Rattachement facultatif à la facture qui a déclenché la consommation.
  invoiceId      String?               @map("invoice_id")
  // Qui a fait le mouvement. Null pour une consommation automatique.
  actorId        String?               @map("actor_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  // Le relevé se lit toujours antéchronologiquement, par organisation.
  @@index([organizationId, createdAt])
  @@map("credit_transaction")
}

enum CreditTransactionType {
  // Rechargement décidé par facture.gn (console d'administration).
  purchase
  // Débit à l'usage : SMS, WhatsApp.
  consumption
  // Remise en crédit après un envoi facturé mais non parti.
  refund
  // Correction manuelle, geste commercial. Toujours étiquetée comme telle.
  adjustment
}

// Parrainage entre marchands. Une ligne par filleul rattaché.
//
// LE NOM DU FILLEUL EST RECOPIÉ ICI, et ce n'est pas de la négligence : sous
// RLS, le parrain ne voit QUE ses propres lignes (politique sur
// referrer_organization_id). L'organisation du filleul, elle, lui reste
// invisible — c'est une autre organisation. Sans cet instantané, afficher
// « qui j'ai parrainé » exigerait une lecture hors scope, c'est-à-dire un trou
// dans l'isolation pour un simple libellé.
//
// La prime est versée EN CRÉDITS, dans le portefeuille (CreditTransaction) —
// pas en espèces : facture.gn n'a aucun moyen de payer un marchand, et un
// crédit se dépense immédiatement en relances.
model Referral {
  id                     String         @id @default(uuid())
  referrerOrganizationId String         @map("referrer_organization_id")
  // @unique : un marchand n'est parrainé qu'une fois. Sans cette contrainte,
  // deux parrains pourraient revendiquer le même filleul et toucher chacun la
  // prime.
  referredOrganizationId String         @unique @map("referred_organization_id")
  referredName           String         @map("referred_name")
  // Le code effectivement saisi, conservé tel quel : le parrain peut en
  // changer, le rattachement historique ne doit pas bouger.
  code                   String
  status                 ReferralStatus @default(pending)
  convertedAt            DateTime?      @map("converted_at")
  // Montants réellement versés, figés au moment du versement. La grille peut
  // évoluer ; un historique qui changerait rétroactivement serait faux.
  referrerBonusCentimes  BigInt?        @map("referrer_bonus_centimes")
  referredBonusCentimes  BigInt?        @map("referred_bonus_centimes")
  createdAt              DateTime       @default(now()) @map("created_at")

  referrer Organization @relation("ReferralReferrer", fields: [referrerOrganizationId], references: [id])
  referred Organization @relation("ReferralReferred", fields: [referredOrganizationId], references: [id])

  @@index([referrerOrganizationId, createdAt])
  @@map("referral")
}

enum ReferralStatus {
  // Filleul inscrit, encore en Freemium : aucune prime versée.
  pending
  // Premier abonnement payant activé : les deux primes ont été créditées.
  converted
}

model Branch {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  name           String
  type           BranchType

  createdAt DateTime @default(now()) @map("created_at")

  organization       Organization               @relation(fields: [organizationId], references: [id])
  invoices           Invoice[]
  productStocks      ProductStock[]
  recurringTemplates RecurringInvoiceTemplate[]
  devices            Device[]

  @@map("branch")
}

// E10 — champs fidèles à l'ERD (ERD-facture-gn.md §PRODUCT). costPrice nullable :
// "la création du produit n'est jamais bloquée en son absence" (E6, ADR-084) —
// cette story ne construit AUCUN endpoint qui le renseigne (territoire E6),
// seulement le champ pour compatibilité de schéma future.
// E3, ADR-038 — possibleDuplicateOf : même pattern que Customer.possibleDuplicateOf
// (auto-relation nullable, jamais une contrainte bloquante). Posé par
// ProductsService.create() (dédoublonnage par nom, exact match insensible à la
// casse, contre l'organisation) — jamais de fusion automatique, juste un signal
// informatif pour une résolution manuelle éventuelle (aucun ProductsService.merge()
// n'existe : le Backlog ne demande la fusion QUE pour les clients, E4).
model Product {
  id                   String  @id @default(uuid())
  organizationId       String  @map("organization_id")
  name                 String
  taxExemptionCategory String? @map("tax_exemption_category")
  costPrice            BigInt? @map("cost_price")
  possibleDuplicateOf  String? @map("possible_duplicate_of")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  stocks        ProductStock[]
  invoiceLines  InvoiceLine[]
  duplicateOf   Product?       @relation("ProductDuplicate", fields: [possibleDuplicateOf], references: [id])
  possibleDupes Product[]      @relation("ProductDuplicate")

  // Gap produit comblé ici (E3/E10, ADR-038) — ProductsService.create() fait un
  // findFirst({organizationId, name}) non indexé à CHAQUE création (dédoublonnage
  // par nom). Même raisonnement que customer_phone_idx (20260823130000) : sans cet
  // index, ce scan dégrade linéairement avec la taille du catalogue de
  // l'organisation. Composite (pas juste sur name) : jamais de scan cross-organisation,
  // et GET /products (listAllByOrganization, orderBy name) s'appuie sur le même index.
  @@index([organizationId, name])
  @@map("product")
}

// E10, ADR-037 — le TYPE de mouvement (reception/adjustment/loss) n'est jamais
// persisté (aucune table de ledger dans l'ERD, voir PLAN "Alternatives
// écartées") — donc pas un enum Prisma ici (un enum non référencé par un champ
// de modèle n'apparaîtrait pas dans le client généré). Défini comme type
// TypeScript local dans product-stock.service.ts, validé pour cohérence de
// signe à la requête uniquement.

// @@unique([productId, branchId]) : absent de l'ERD littéral mais nécessaire —
// sans lui, "le niveau de stock actuel" d'un produit dans une succursale
// serait ambigu sous plusieurs lignes concurrentes.
model ProductStock {
  id        String @id @default(uuid())
  productId String @map("product_id")
  branchId  String @map("branch_id")
  stockQty  Int?   @map("stock_qty")

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@map("product_stock")
}

// C6, ADR-039 — "credit_limit/running_balance (calculé sur amount_due),
// account_statement sans hash". running_balance n'est PAS une colonne ici :
// c'est une valeur dérivée (SUM(Invoice.amountDue) sur les factures actives du
// client), calculée à la demande par CustomersService — jamais une source de
// vérité dupliquée. is_public_entity/public_buyer_account_id (ERD) marqués V2,
// jamais scaffoldés ici.
// E4, ADR-038 — "jamais de fusion automatique, résolution manuelle" :
// possibleDuplicateOf reste un pointeur informatif, jamais un déclencheur
// automatique — la fusion (CustomersService.merge()) accepte n'importe quelle
// paire de clients de la même organisation, que ce champ soit renseigné ou non.
enum NotificationChannel {
  sms
  whatsapp
  both
}

model Customer {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  name           String
  phone          String?
  nif            String?

  creditLimit         BigInt?             @map("credit_limit")
  possibleDuplicateOf String?             @map("possible_duplicate_of")
  // C9 — canal d'envoi du lien de paiement, choisi par la PME à la création du
  // client (pas au niveau organisation : le moyen de contact réel d'un client
  // est indépendant des autres clients de la même PME). Sans effet si phone
  // est null (aucune tentative d'envoi).
  notificationChannel NotificationChannel @default(sms) @map("notification_channel")

  // F16, ADR-105 — sans ce marquage, le portail Niveau 2 (J1/J2) n'a
  // structurellement aucune facture à présenter à un DAF. Réservé admin/owner
  // (CustomersService.flagPublicEntity()), même trio restreint que merge() (E4).
  isPublicEntity       Boolean @default(false) @map("is_public_entity")
  publicBuyerAccountId String? @map("public_buyer_account_id")
  // Security Audit 2026-08-23, finding #13 — flagPublicEntity() posait jusqu'ici
  // isPublicEntity/publicBuyerAccountId sur la seule initiative de la PME, sans
  // aucun accord du compte acheteur public ciblé (qui peut être un compte réel et
  // légitime). false à la création du lien, jamais true tant qu'un membre
  // (public_buyer_validator) du compte visé n'a pas explicitement confirmé via
  // PublicBuyerPortalService.confirmCustomerLink() — seul ce champ conditionne
  // désormais la visibilité du client dans listReceivedInvoices()/validateLiquidation().
  isPublicEntityConfirmed Boolean @default(false) @map("is_public_entity_confirmed")

  // J2, ADR-116 — horodatage d'une demande d'anonymisation honorée (L/2016/037).
  // La ligne est CONSERVÉE (intégrité des factures — Invoice.customerId), seuls
  // ses champs PII sont effacés (tombstone). Une ligne anonymisée est GELÉE : le
  // dédoublonnage par téléphone l'ignore, merge()/flagPublicEntity()/
  // proposeCreditLimit() la refusent. Anonymisation partielle (factures sous
  // conservation OHADA) : name/nif conservés, contact effacé.
  anonymizedAt DateTime? @map("anonymized_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization        Organization               @relation(fields: [organizationId], references: [id])
  publicBuyerAccount  PublicBuyerAccount?        @relation(fields: [publicBuyerAccountId], references: [id])
  invoices            Invoice[]
  duplicateOf         Customer?                  @relation("CustomerDuplicate", fields: [possibleDuplicateOf], references: [id])
  possibleDupes       Customer[]                 @relation("CustomerDuplicate")
  creditLimitRequests CreditLimitChangeRequest[]
  recurringTemplates  RecurringInvoiceTemplate[]

  // F13, revue post-fix #3 — seul point d'entrée du repo qui interroge Customer
  // par téléphone à travers TOUTES les organisations (ClientPortalService),
  // contrairement au reste du repo où Customer est toujours filtré par
  // organizationId d'abord (scan borné à une PME). Sans index, scan séquentiel
  // complet à l'échelle de la plateforme à chaque appel.
  @@index([phone])
  @@map("customer")
}

// ===== Portail acheteur public — B2G Niveau 2 (J1/J2, ADR-080/081/098) =====
// Entité de premier niveau PARALLÈLE à Organization — même famille architecturale
// que ProfessionalPractice (ADR-068) : un DAF n'est jamais membre d'une
// organisation PME, jamais un OrganizationRole. Self-service (même précédent que
// ProfessionalPractice.create()) : aucune vérification institutionnelle en V1.
// Security Audit 2026-08-23, finding #1 (CRITIQUE) — create() reste self-service
// (aucune vérification institutionnelle en V1, décision produit d'origine
// inchangée), mais un compte "pending" ne peut plus, à lui seul, rendre une
// facture finançable (voir is-financeable.ts::financeableInvoiceWhere) : sans
// cette barrière, n'importe qui pouvait créer un faux acheteur public, s'auto-
// flaguer client, puis s'auto-valider comme administration. Bascule vers
// "verified" volontairement SANS endpoint HTTP dédié — même précédent déjà
// accepté dans ce repo pour FinancialPartner (seedé/activé hors API, aucun
// besoin exprimé) : la vérification institutionnelle réelle d'un DAF est un
// processus humain/ops (runbook), pas encore un flux produit spécifié.
enum PublicBuyerAccountVerificationStatus {
  pending
  verified
  rejected
}

model PublicBuyerAccount {
  id                 String                               @id @default(uuid())
  name               String
  verificationStatus PublicBuyerAccountVerificationStatus  @default(pending) @map("verification_status")
  createdAt          DateTime                              @default(now()) @map("created_at")

  members   PublicBuyerAccountMember[]
  customers Customer[]

  @@map("public_buyer_account")
}

// Une seule valeur aujourd'hui — enum plutôt que String brute, même précédent
// que DepositType (cohérence avec les autres champs discriminants du schema, et
// une future distinction de rôle DAF ne pourra jamais introduire une valeur mal
// orthographiée qui échapperait silencieusement à l'autorisation inline de
// PublicBuyerPortalService).
enum PublicBuyerAccountMemberRole {
  public_buyer_validator
}

// userId @unique (pas seulement [publicBuyerAccountId, userId]) — encode au niveau
// schéma l'invariant "un DAF n'appartient qu'à un seul public_buyer_account en V1"
// dont dépend PublicBuyerPortalService.listReceivedInvoices() (résolution du
// membership par userId seul). PublicBuyerAccountsService.create() vérifie déjà
// cet invariant en amont (message d'erreur clair) — cette contrainte est le filet
// qui le rend réellement infranchissable, y compris sous concurrence.
model PublicBuyerAccountMember {
  id                   String                       @id @default(uuid())
  publicBuyerAccountId String                       @map("public_buyer_account_id")
  userId               String                       @unique @map("user_id")
  role                 PublicBuyerAccountMemberRole
  joinedAt             DateTime                     @default(now()) @map("joined_at")

  publicBuyerAccount PublicBuyerAccount @relation(fields: [publicBuyerAccountId], references: [id])
  user               User               @relation(fields: [userId], references: [id])

  @@map("public_buyer_account_member")
}

model Invoice {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  branchId       String? @map("branch_id")
  customerId     String? @map("customer_id")

  // FG-YYYY-NNNNNN — séquentiel légal OHADA Article 23, unique par organisation
  // (ERD ligne 208), pas globalement : deux organisations différentes émettent
  // chacune leur propre séquence à partir de 1 (voir @@unique([organizationId,
  // number]) plus bas — jamais un @unique seul sur ce champ).
  // Nullable tant que draft : le numéro n'est consommé qu'à l'émission (issue),
  // jamais à la création du brouillon — sinon un brouillon abandonné créerait un trou.
  number String?

  // GN-{NIF8}-{YYYY}-{HASH6} — vérification publique, non-séquentiel.
  // Nullable tant que la facture n'est pas issued (pas de draft certifié).
  certificationId String? @unique @map("certification_id")

  documentType  InvoiceDocumentType @default(invoice) @map("document_type")
  status        InvoiceStatus       @default(draft)
  disputeStatus DisputeStatus       @default(none) @map("dispute_status")

  // Lot D — @default(pwa) : les factures antérieures à ce champ sont estampillées
  // 'pwa' (canal primaire), on ne peut pas reconstruire a posteriori qu'une
  // facture est venue de *620# ou d'un agent terrain. Jamais dans CertifiablePayload.
  emissionChannel EmissionChannel @default(pwa) @map("emission_channel")

  validatedByAdministration Boolean @default(false) @map("validated_by_administration")

  totalHt  BigInt @default(0) @map("total_ht")
  totalTva BigInt @default(0) @map("total_tva")
  totalTtc BigInt @default(0) @map("total_ttc")

  discountPct Int @default(0) @map("discount_pct")

  amountPaid        BigInt @default(0) @map("amount_paid")
  amountDue         BigInt @default(0) @map("amount_due")
  overpaymentAmount BigInt @default(0) @map("overpayment_amount")

  paymentLinkUrl       String?   @map("payment_link_url")
  paymentLinkId        String?   @map("payment_link_id")
  paymentLinkExpiresAt DateTime? @map("payment_link_expires_at")

  referenceCurrency String?   @map("reference_currency")
  referenceAmount   BigInt?   @map("reference_amount")
  fxRate            Decimal?  @map("fx_rate")
  fxRateDate        DateTime? @map("fx_rate_date")

  recurringTemplateId  String? @map("recurring_template_id")
  convertedToInvoiceId String? @unique @map("converted_to_invoice_id")

  recurringTemplate RecurringInvoiceTemplate? @relation(fields: [recurringTemplateId], references: [id])

  quoteValidUntil DateTime? @map("quote_valid_until")

  // B2G — références déclaratives, recopiées telles quelles à l'émission, AUCUNE
  // vérification automatique (même discipline que referenceMarche / ADR-090 ;
  // le DAF rapproche humainement au moment de la validation de liquidation).
  // Alignement EN 16931 (Lot C, ADR-109) : referenceMarche = BT-17 (marché/lot),
  // numeroBonCommande = BT-13, numeroContrat = BT-12, numeroEngagement = hors
  // EN 16931 core (engagement budgétaire Trésor, spécifique Guinée — mappera
  // BT-19 à l'export UBL 2.1 / ADR-053). Jamais dans CertifiablePayload.
  referenceMarche   String?      @map("reference_marche")
  cadreFacturation  InvoiceCadre @default(standard) @map("cadre_facturation")
  numeroBonCommande String?      @map("numero_bon_commande")
  numeroContrat     String?      @map("numero_contrat")
  numeroEngagement  String?      @map("numero_engagement")

  // K4/K5, ADR-089 — la seule présence de financedByPartnerId bloque tout second
  // financement (K5). Snapshot jamais réévalué : une facture financée le reste,
  // même si le partenaire change de statut ensuite.
  financedByPartnerId String?           @map("financed_by_partner_id")
  financedAt          DateTime?         @map("financed_at")
  financedByPartner   FinancialPartner? @relation(fields: [financedByPartnerId], references: [id])

  hash         String?
  previousHash String? @map("previous_hash")
  signature    Bytes?
  // E1 (ADR-115) — tranche Merkle à laquelle le hash de cette facture est
  // rattaché. Assignée UNE seule fois par MerkleAnchorSealService ; un trigger
  // (invoice_anchor_batch_id_write_once) rejette toute ré-assignation d'une
  // valeur non nulle. onDelete: Restrict (une tranche ne se supprime jamais —
  // trigger — ; Restrict est plus honnête que SetNull). La preuve d'inclusion
  // est reconstruite à la volée par /verify.
  anchorBatchId String?            @map("anchor_batch_id")
  anchorBatch   MerkleAnchorBatch? @relation(fields: [anchorBatchId], references: [id], onDelete: Restrict)
  // A3 — null = signée avec l'ancienne clé globale légataire (toutes les
  // factures émises avant cette story, jamais retouchées, jamais re-vérifiées
  // différemment). Non-null = signée avec la clé racine propre à l'organisation
  // référencée. Ne JAMAIS migrer une facture existante vers l'autre valeur —
  // un système de confiance ne peut jamais invalider une certification déjà émise.
  signingKeyId String? @map("signing_key_id")

  issuedAt  DateTime? @map("issued_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // ── Transmission unitaire e-TVA (LFI 2025) ──────────────────────────────
  // NULL = hors périmètre, et c'est la valeur de l'immense majorité des lignes :
  // tout brouillon, et toute facture émise pendant que ETAX_ENABLED est à false.
  // Un défaut `pending` aurait menti — il aurait présenté comme « en attente de
  // la DGI » des factures que personne n'a jamais mises en file.
  etaxStatus        EtaxTransmissionStatus? @map("etax_status")
  // Le reçu officiel de la DGI. C'est LA preuve de dépôt : sans lui, la facture
  // n'a pas été transmise, quoi que dise le statut.
  etaxReceiptNumber String?                 @map("etax_receipt_number")
  etaxTransmittedAt DateTime?               @map("etax_transmitted_at")

  organization  Organization            @relation(fields: [organizationId], references: [id])
  branch        Branch?                 @relation(fields: [branchId], references: [id])
  customer      Customer?               @relation(fields: [customerId], references: [id])
  signingKey    OrganizationSigningKey? @relation(fields: [signingKeyId], references: [id])
  convertedFrom Invoice?                @relation("InvoiceConversion", fields: [convertedToInvoiceId], references: [id])
  convertedInto Invoice[]               @relation("InvoiceConversion")
  lines         InvoiceLine[]
  events        InvoiceEvent[]
  payments      Payment[]
  creditNotes   CreditNote[]
  refunds       Refund[]
  bankTransactionsMatched BankTransaction[]
  creditTransactions      CreditTransaction[]
  pdpRawTransaction       PdpRawTransaction?

  @@unique([organizationId, number])
  // E1 — reconstruction de la preuve d'inclusion (feuilles d'une tranche).
  @@index([anchorBatchId])
  @@map("invoice")
}

// E1 (ADR-115 provisoire) — registre des racines de Merkle des factures, CHAÎNÉ
// (previousRoot). Chaque tranche est un engagement compact sur les hashes des
// factures certifiées non encore rattachées à l'instant du scellement, destiné
// à être ancré hors du contrôle de facture.gn (seam AnchorSink : Noop par
// défaut, futurs sinks Bitcoin RPC / IPFS).
//
// Colonnes d'identité (asOf, coverageFrom, merkleRoot, previousRoot, leafCount,
// createdAt) IMMUABLES en base (trigger merkle_anchor_batch_identity_immutable) ;
// UPDATE des seules colonnes anchor* / anchoredAt / anchorAttempts autorisé
// (write-once-later par le flush) ; DELETE et TRUNCATE interdits.
// CHECK anchor_status_consistency : (anchored ⟺ anchoredAt renseigné) ET
// (proof/ref ensemble) ET (proof ⟹ anchored). Table CROSS-ORGANISATION → hors
// RLS (comme payment_webhook).
model MerkleAnchorBatch {
  id           String             @id @default(uuid())
  // Borne haute EXCLUSIVE réelle de la tranche : toute facture issuedAt < asOf
  // non encore rattachée y est incluse. Une tranche peut couvrir plusieurs
  // heures (retardataires, downtime). asOf @unique — un scellement par borne.
  asOf         DateTime           @unique @map("as_of")
  // Min(issuedAt) des factures de la tranche : la période réellement engagée.
  coverageFrom DateTime           @map("coverage_from")
  merkleRoot   String             @map("merkle_root")
  // Chaînage. previousRoot @unique : la chaîne ne peut pas FORKER (deux tranches
  // partageant un prédécesseur) même si deux runs de scellement concurrents
  // d'asOf différents lisent la même dernière tranche — le second insert échoue
  // (P2002), ses factures repartent au run suivant. "GENESIS" pour la 1re.
  previousRoot String             @unique @map("previous_root")
  leafCount    Int                @map("leaf_count")
  anchorStatus MerkleAnchorStatus @default(pending) @map("anchor_status")
  anchorProof  String?            @map("anchor_proof")
  anchorRef    String?            @map("anchor_ref")
  anchoredAt   DateTime?          @map("anchored_at")
  // Nombre d'appels au seam pour cette tranche (par le flush). Alerter sur
  // pending + attempts élevé plutôt qu'un seuil temporel flou.
  anchorAttempts Int              @default(0) @map("anchor_attempts")
  createdAt    DateTime           @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([anchorStatus])
  @@map("merkle_anchor_batch")
}

enum MerkleAnchorStatus {
  pending
  anchored
  failed
}

// I1, ADR-056 — jamais de taux/régime fiscal figé : lines ne contient que des
// données commerciales pures (description, quantity, unitPrice, productId
// optionnel — même shape que createInvoiceSchema.lines), le régime est
// toujours recalculé par InvoicesService.createDraft() au moment de chaque
// génération (C4), jamais lu depuis ce modèle. lastKnownRegimeFiscal N'EST PAS
// une valeur figée pour la facturation — seulement une référence de
// comparaison pour détecter une dérive et déclencher un InvoiceEvent
// regime_change (flag de revue, jamais bloquant — "alerte, jamais un mur
// silencieux", ADR-056). intervalDays + lastGeneratedAt protègent contre une
// double génération pour la même période (garde de concurrence, voir
// recurring-templates.service.ts).
model RecurringInvoiceTemplate {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  customerId     String? @map("customer_id")
  branchId       String? @map("branch_id")

  lines Json

  discountPct  Int @default(0) @map("discount_pct")
  intervalDays Int @map("interval_days")

  lastGeneratedAt       DateTime?     @map("last_generated_at")
  lastKnownRegimeFiscal RegimeFiscal? @map("last_known_regime_fiscal")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  invoices     Invoice[]

  @@map("recurring_invoice_template")
}

model Payment {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  // centimes GNF — ce que le marchand reçoit pour un règlement normal (depositType
  // null) ; pour une arrhes (depositType=arrhes, C5), le montant du dépôt de
  // sécurité lui-même, jamais appliqué au solde de la facture (Invoice.amountPaid/
  // amountDue) — deux significations distinctes de la même colonne, jamais mélangées
  // par les chemins d'écriture (recordCashPayment/recordProviderPayment vs
  // recordDepositPayment).
  amount            BigInt @map("amount")
  amountCollected   BigInt @map("amount_collected") // centimes GNF — ce que le payeur a payé
  platformFeeAmount BigInt @default(0) @map("platform_fee_amount")
  gatewayFeeAmount  BigInt @default(0) @map("gateway_fee_amount")

  method            PaymentMethod @default(cash)
  providerSubMethod String?       @map("provider_sub_method")
  depositType       DepositType?  @map("deposit_type")
  providerRef       String?       @map("provider_ref")
  status            PaymentStatus @default(pending)

  // Contrainte unique = mécanisme d'idempotence (header Idempotency-Key, ADR-016) —
  // pas de Redis dans ce repo, un replay renvoie ce paiement plutôt que d'en recréer un.
  idempotencyKey String @unique @map("idempotency_key")

  // Preuve obligatoire au-delà de cash_proof_threshold_gnf (DAT §config, 1M GNF) —
  // référence à un objet déjà uploadé côté client (MinIO WORM hors scope de ce plan,
  // pas encore scaffoldé dans ce repo), jamais de gestion d'upload ici.
  proofPhotoUrl  String? @map("proof_photo_url")
  proofGpsLat    Float?  @map("proof_gps_lat")
  proofGpsLng    Float?  @map("proof_gps_lng")
  proofSignature String? @map("proof_signature")

  collectedAt DateTime @default(now()) @map("collected_at")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  bankTransaction BankTransaction?

  @@map("payment")
}

// G3, ADR-091 — trace auditable de la revue manuelle Squad Money (Niveau 3/4),
// même pattern que CreditLimitChangeRequest (E5). Pas de resolvedByUserId :
// Squad Money n'est représenté par aucun User dans ce schéma (même limite déjà
// acceptée pour OrganizationsService.verifyDgi(), B2 — aucun acteur tracé pour
// une action "système"/interne). detectedPatterns : snapshot des patterns lus
// par l'opérateur au moment de l'ouverture (journal d'audit G4), jamais
// recalculé après coup.
model CommissionBypassCase {
  id               String                     @id @default(uuid())
  organizationId   String                     @map("organization_id")
  status           CommissionBypassCaseStatus @default(pending)
  detectedPatterns Json                       @map("detected_patterns")
  createdAt        DateTime                   @default(now()) @map("created_at")
  resolvedAt       DateTime?                  @map("resolved_at")
  // Revue dev-domain-model-reviewer : resolveCase() est une décision humaine
  // discrétionnaire (dismiss/restrict) sur un dossier de fraude potentielle —
  // même nature que CreditLimitChangeRequest.resolvedByUserId (E5), jamais
  // verifyDgi() (B2, déclenchement automatisé sans nuance). Pas de FK vers
  // User (Squad Money n'y est représenté par aucune ligne) : chaîne libre
  // fournie par l'outil interne appelant, jamais validée contre une table —
  // traçabilité "qui" en plus du "pourquoi" (detectedPatterns), sans les
  // garanties d'intégrité référentielle qu'une vraie FK offrirait.
  resolvedByOperatorId String? @map("resolved_by_operator_id")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("commission_bypass_case")
}

// E7, ADR-084 — productId devient une vraie relation FK : la condition qui
// l'empêchait ("tant que PRODUCT n'existe pas") n'est plus vraie depuis E10.
// costPriceAtTime est un SNAPSHOT immuable de Product.costPrice au moment de
// la création de la ligne (jamais recalculé si le coût change ensuite) —
// jamais inclus dans le payload certifié (CertifiablePayload ne porte que
// invoiceId/organizationNif/number/totalTtc/issuedAt/previousHash, vérifié
// dans organization-signing-key.service.ts) : aucun risque de contaminer la
// signature publique avec une donnée commerciale confidentielle.
model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  productId String? @map("product_id")

  description String
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  taxRateBps  Int    @default(0) @map("tax_rate_bps")

  // ADR-108 — dit si unitPrice ci-dessus est TTC (parcours marchand) ou HT
  // (passerelle PDP). SANS EFFET SUR LES MONTANTS : c'est un indicateur de
  // PROVENANCE, lu par le rendu PDF et le front pour intituler correctement les
  // colonnes et sommer les lignes dans la bonne unité. Les totaux généraux
  // (totalHt/totalTva/totalTtc) restent ceux scellés sur la facture.
  //
  // Défaut TTC_FIRST : toutes les lignes antérieures à l'ADR-108 viennent du
  // parcours marchand, la valeur est donc exacte pour l'historique — jamais un
  // simple remplissage. Non-nullable pour cette raison : une ligne dont on
  // ignorerait le régime serait inaffichable sans deviner.
  saisieRegime SaisieRegime @default(TTC_FIRST) @map("saisie_regime")

  costPriceAtTime BigInt? @map("cost_price_at_time")

  // Lot C, ADR-109 — EN 16931 BT-157 (identifiant standard de l'article :
  // référence catalogue acheteur, nomenclature CPV…). Déclaratif, jamais
  // vérifié. Distinct de productId (FK catalogue interne de la PME).
  productCode String? @map("product_code")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  // ON DELETE SET NULL : la suppression future d'un produit ne doit jamais
  // bloquer/casser une ligne de facture déjà émise (immuable après issue()).
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  creditNoteLines CreditNoteLine[]

  @@map("invoice_line")
}

// ADR-040, C7 — mécanisme de correction d'une facture déjà émise, jamais une
// mutation directe (Invoice reste immuable après issue()). amount est un total
// unique (pas de ventilation HT/TVA par ligne, cf. ERD) calculé côté serveur à
// l'émission — jamais une valeur de confiance du client (même principe que
// taxRateBps, C4). N'affecte JAMAIS Invoice.totalTtc/amountDue/amountPaid : bucket
// financier délibérément séparé, même précédent que les arrhes (Payment.depositType
// = "arrhes", C5). refundMultiplier (1 ou 2) référence ADR-034 (arrhes + annulation
// professionnelle) sans intégration avec forfeitDeposit() à ce stade.
model CreditNote {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  amount           BigInt // centimes GNF
  refundMultiplier Int      @default(1) @map("refund_multiplier")
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]
  refunds Refund[]

  @@map("credit_note")
}

// quantity_returned est une QUANTITÉ, pas un montant (cf. ERD) — la trace du
// "niveau ligne" d'ADR-040 sert à savoir quelles lignes et combien d'unités ont été
// créditées, la ventilation monétaire reste un total unique sur CreditNote.amount.
model CreditNoteLine {
  id               String @id @default(uuid())
  creditNoteId     String @map("credit_note_id")
  invoiceLineId    String @map("invoice_line_id")
  quantityReturned Int    @map("quantity_returned")

  creditNote  CreditNote  @relation(fields: [creditNoteId], references: [id])
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])

  @@map("credit_note_line")
}

enum RefundMethod {
  cash
  payment_link_payout
  bank_transfer
  credit_on_account
}

enum RefundStatus {
  pending
  completed
  failed
}

// ADR-063, C13 — "credit_note = document comptable. refund = mouvement d'argent."
// Deux faits distincts, jamais confondus : CreditNote peut exister sans jamais être
// remboursé (crédit conservé côté client). payment_link_payout (Djomy Payout,
// fallback Moneroo) est créé "pending" — aucune exécution ni confirmation
// automatique construite ici (V2, ADR-089/FINANCIAL_PARTNER, aucune intégration
// Money Context payout n'existe dans ce repo). cash/bank_transfer/credit_on_account
// sont des attestations immédiates du staff (même principe que
// recordCashPayment()/recordBankTransferPayment(), C1/C3) : "completed" dès la
// création, jamais "pending".
model Refund {
  id           String       @id @default(uuid())
  creditNoteId String       @map("credit_note_id")
  invoiceId    String       @map("invoice_id")
  amount       BigInt // centimes GNF
  method       RefundMethod
  providerRef  String?      @map("provider_ref")
  status       RefundStatus @default(pending)
  // Security Audit 2026-08-23, finding #2 — même pattern que Payment.idempotencyKey :
  // sans contrainte unique, deux requêtes concurrentes (double clic, retry réseau)
  // passaient toutes deux la garde anti-sur-remboursement avant qu'aucune n'ait
  // committé, produisant un sur-remboursement réel.
  idempotencyKey String @unique @map("idempotency_key")
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  invoice    Invoice    @relation(fields: [invoiceId], references: [id])

  @@map("refund")
}

model InvoiceEvent {
  id        String           @id @default(uuid())
  invoiceId String           @map("invoice_id")
  type      InvoiceEventType
  actorId   String?          @map("actor_id")
  amount    BigInt?
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@map("invoice_event")
}

// Lot B, ADR-110 — arrêté des comptes OHADA/SYSCOHADA. Sceau IRRÉVERSIBLE d'un
// exercice : une fois posé, InvoicesService.issue() refuse toute émission dont
// l'année d'issuedAt est close (protège les BORNES temporelles — la séquence
// Article 23 et le chaînage Ed25519 ne protègent que l'ordre relatif). Aucune
// réouverture : une erreur se corrige comptablement dans l'exercice suivant.
// @@unique([organizationId, year]) = idempotence (une seule clôture par
// exercice). sealHash : SHA-256 canonique de {org, year, lastInvoiceNumber,
// lastInvoiceHash, totalHt, totalTva, totalTtc, invoiceCount} — même primitive
// que certification.service.ts. lastInvoice* nullables : un exercice sans
// aucune facture émise est clôturable (totaux 0).
model FiscalPeriodClosing {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  year              Int
  lastInvoiceNumber String?  @map("last_invoice_number")
  lastInvoiceHash   String?  @map("last_invoice_hash")
  totalHt           BigInt   @map("total_ht")
  totalTva          BigInt   @map("total_tva")
  totalTtc          BigInt   @map("total_ttc")
  invoiceCount      Int      @map("invoice_count")
  sealHash          String   @map("seal_hash")
  closedAt          DateTime @default(now()) @map("closed_at")
  closedByUserId    String   @map("closed_by_user_id")

  // Chantier 5, étape 3 — suivi de la télétransmission eTax. Sans cet état
  // persistant, la file BullMQ serait la SEULE mémoire de ce qui a été déclaré
  // à la DGI : un job perdu (Redis vidé, 5 tentatives épuisées, enfilement
  // manqué parce que Redis était éteint à la clôture) deviendrait un exercice
  // jamais déclaré, sans aucune trace pour le rattraper. Ces deux colonnes
  // rendent le rattrapage possible par simple requête : « quelles clôtures
  // n'ont pas de etax_submitted_at ».
  //
  // Elles rendent aussi le worker IDEMPOTENT : un réessai BullMQ après un
  // acquittement partiel (eTax a reçu, la réponse s'est perdue) ne redéclare
  // pas l'exercice — on ne peut pas retirer une déclaration fiscale envoyée.
  etaxSubmittedAt   DateTime? @map("etax_submitted_at")
  // Référence d'acquittement rendue par eTax — la preuve, côté PME, que la
  // déclaration est arrivée. Nullable tant que non transmise.
  etaxSubmissionRef String?   @map("etax_submission_ref")

  organization Organization @relation(fields: [organizationId], references: [id])
  closedBy     User         @relation(fields: [closedByUserId], references: [id])

  @@unique([organizationId, year])
  @@map("fiscal_period_closing")
}

// ===== Money Context (Squad Money) — orchestrateur de paiement =====
// Périmètre C2 Phase 1 (docs/plans/2026-08-08-money-context-payment-orchestrator.md) :
// traçabilité par tentative de paiement (ADR-076) uniquement. PAYMENT_WEBHOOKS
// (ADR-075) et le câblage sur invoices.service.ts.issue() sont une Phase 2 séparée.

enum PaymentProviderName {
  djomy
  moneroo
  orange_direct
  mtn_direct
}

enum PaymentProviderAttemptStatus {
  pending
  success
  failed
  timeout
}

// Propriété d'écriture exclusive de money-api (Trust Context ne modifie jamais
// cette table) — même base Postgres partagée via packages/db, bounded contexts
// séparés au niveau applicatif, pas au niveau base de données pour ce MVP.
model PaymentProviderAttempt {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  provider PaymentProviderName
  status   PaymentProviderAttemptStatus @default(pending)

  providerRef    String?   @map("provider_ref")
  idempotencyKey String?   @map("idempotency_key")
  amountGnf      BigInt    @map("amount_gnf")
  feeGateway     BigInt    @default(0) @map("fee_gateway")
  feePlatform    BigInt    @default(0) @map("fee_platform")
  // Transitoires dans CreatePaymentLinkResult jusqu'ici, jamais persistés — requis
  // pour que le checkout public (C19) réponde seul, sans traverser vers trust-api
  // depuis le frontend (voir plan public-checkout-page).
  paymentLinkUrl String?   @map("payment_link_url")
  expiresAt      DateTime? @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")

  @@index([idempotencyKey])
  @@map("payment_provider_attempt")
}

enum WebhookNormalizedStatus {
  paid
  failed
  pending
}

// ADR-075 — un webhook n'est inséré qu'APRÈS traitement complet réussi (jamais un
// état à moitié traité) : @@unique([provider, providerRef]) sert de garde de
// dédoublonnage ET de preuve d'auditabilité complète. Propriété exclusive de
// money-api, même raisonnement que PaymentProviderAttempt.
model PaymentWebhook {
  id String @id @default(uuid())

  provider    PaymentProviderName
  providerRef String              @map("provider_ref")

  payload          Json
  normalizedStatus WebhookNormalizedStatus @map("normalized_status")
  signatureValid   Boolean                 @map("signature_valid")

  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, providerRef])
  @@map("payment_webhook")
}

// ===== Écosystème cabinet (F4, ADR-068/078) =====

enum ProfessionalPracticeType {
  cabinet_comptable
  gestionnaire
  fiduciaire
  cga
}

enum RevenueShareSettlementMode {
  payout
  subscription_deduction
}

enum ProfessionalPracticeTier {
  partner_free
  partner_starter
  partner_pro
  partner_institutional
}

// practice_admin/accountant_external/business_manager — jamais un OrganizationRole
// (les 7 valeurs existantes sont toutes scopées à une organisation) : ADR-068 est
// explicite, une practice est une "entité de premier niveau PARALLÈLE à
// organization", jamais rattachée à une Organization existante. MANDATE (practice →
// organization, ADR-069) est le mécanisme d'accès multi-org, pas cet enum — hors
// scope de F4 (stories F1/F5/F6 séparées).
enum PracticeMemberRole {
  practice_admin
  accountant_external
  business_manager
}

// Aucun @Roles() sur la route de création (voir practices.controller.ts) — même
// principe que organizations.controller.ts:create() : n'importe quel utilisateur
// authentifié peut créer une practice, il en devient automatiquement practice_admin.
// ordreVerified reste à son défaut false ici — même pattern que
// Organization.dgiVerificationStatus (B1/B4 scaffoldent, B2 construit la
// vérification plus tard comme story séparée). tier jamais accepté du client,
// défaut système partner_free (même principe que Organization.commercialTier).
model ProfessionalPractice {
  id                 String                   @id @default(uuid())
  type               ProfessionalPracticeType
  name               String
  registrationNumber String?                  @map("registration_number")
  ordreVerified      Boolean                  @default(false) @map("ordre_verified")
  tier               ProfessionalPracticeTier @default(partner_free)
  phone              String
  email              String?
  createdAt          DateTime                 @default(now()) @map("created_at")

  // H3, ADR-071, Grille-Offres §5.2 — mode de règlement de l'abonnement Partner
  // face aux crédits de revenue share (H4) : payout (défaut, comportement H4
  // inchangé — le crédit est encaissable séparément) ou subscription_deduction
  // (le crédit vient en déduction du prix du palier, voir
  // RevenueShareService.getPartnerSubscriptionStatus()). Ne touche JAMAIS
  // RevenueShareCredit existant, oriente seulement le calcul à la lecture.
  revenueShareSettlementMode RevenueShareSettlementMode @default(payout) @map("revenue_share_settlement_mode")

  members              PracticeMember[]
  mandates             Mandate[]
  revenueShareCredits  RevenueShareCredit[]
  pendingMemberInvites PendingMemberInvite[]

  @@map("professional_practice")
}

model PracticeMember {
  id                  String             @id @default(uuid())
  practiceId          String             @map("practice_id")
  userId              String             @map("user_id")
  role                PracticeMemberRole
  permissionsOverride Json?              @map("permissions_override")
  joinedAt            DateTime           @default(now()) @map("joined_at")
  // Nullable — peuplé quand le membre quitte (ERD) ; aucun mécanisme de départ
  // construit dans cette story (F4 se limite à la création), le champ existe pour
  // une story future.
  leftAt              DateTime?          @map("left_at")

  practice ProfessionalPractice @relation(fields: [practiceId], references: [id])
  user     User                 @relation(fields: [userId], references: [id])

  @@map("practice_member")
}

// ===== Mandat (F5/F1/F6, ADR-069) =====
// "Mandat (practice → organization) remplace membership individuelle. Accordé à
// l'entité cabinet, pas à un individu." Cette story (F5) ne construit QUE la
// création de la demande (status: pending) — l'acceptation (pending → active,
// grantedBy/grantedAt renseignés, F1/une story dédiée) et la révocation (F6) sont
// hors scope, aucune transition de status n'est construite ici.

enum MandateStatus {
  pending
  active
  revoked
  expired
}

// business_manager reste V1 (ADR-070) — scaffoldé fidèlement depuis l'ERD, mais
// create-mandate.dto.ts ne l'accepte pas encore côté client.
enum MandateGrantedRole {
  accountant_external
  business_manager
}

// F12, ADR-078 — "adhérer à un CGA" inverse le sens d'initiation habituel
// (F1/F5 : practice demande, organisation accepte). initiatedBy distingue les
// deux sens et empêche structurellement qu'une practice s'auto-accepte une
// demande qu'elle a elle-même créée (accept()/acceptAsPractice() vérifient
// chacun le sens attendu) — jamais nullable, toute demande a une origine connue.
enum MandateInitiator {
  practice
  organization
}

model Mandate {
  id                  String             @id @default(uuid())
  practiceId          String             @map("practice_id")
  organizationId      String             @map("organization_id")
  status              MandateStatus      @default(pending)
  grantedRole         MandateGrantedRole @map("granted_role")
  initiatedBy         MandateInitiator   @map("initiated_by")
  permissionsOverride Json?              @map("permissions_override")
  // Nullable — peuplé seulement à l'acceptation (owner/admin qui a accepté),
  // jamais par cette story (F5 ne fait que créer la demande).
  grantedBy           String?            @map("granted_by")
  requestedAt         DateTime           @default(now()) @map("requested_at")
  grantedAt           DateTime?          @map("granted_at")
  expiresAt           DateTime?          @map("expires_at")
  revokedAt           DateTime?          @map("revoked_at")

  practice     ProfessionalPractice @relation(fields: [practiceId], references: [id])
  organization Organization         @relation(fields: [organizationId], references: [id])
  granter      User?                @relation(fields: [grantedBy], references: [id])

  @@map("mandate")
}

enum RevenueShareCreditStatus {
  pending
  paid
}

// H4, ADR-071 — revenue share cabinet/CGA : 10% de Payment.platformFeeAmount
// (commission facture.gn déjà perçue, status completed uniquement) généré par
// une organisation MANDATÉE (pas ses propres clients CUSTOMER), plafonné à
// 500 000 centimes GNF (5000 GNF)/mois/organisation (revenue-share-grid.ts).
// periodMonth (format "YYYY-MM") + @@unique : idempotence de la génération,
// jamais deux crédits pour la même pratique/organisation/mois — régénérer met
// à jour (upsert), jamais un doublon. status reste "pending" indéfiniment tant
// qu'aucune exécution réelle du virement Djomy Payout n'existe (aucune
// intégration dans ce repo, même limite déjà documentée par refunds.service.ts).
model RevenueShareCredit {
  id                      String                   @id @default(uuid())
  practiceId              String                   @map("practice_id")
  organizationId          String                   @map("organization_id")
  periodMonth             String                   @map("period_month")
  grossCommissionCentimes BigInt                   @map("gross_commission_centimes")
  creditedAmountCentimes  BigInt                   @map("credited_amount_centimes")
  status                  RevenueShareCreditStatus @default(pending)
  createdAt               DateTime                 @default(now()) @map("created_at")

  practice     ProfessionalPractice @relation(fields: [practiceId], references: [id])
  organization Organization         @relation(fields: [organizationId], references: [id])

  @@unique([practiceId, organizationId, periodMonth])
  @@map("revenue_share_credit")
}

// Canal USSD *620# (D1-D4, Spec-USSD-facture-gn.md) — table de session au lieu
// de Redis (aucune autre infra Redis dans ce repo, décision utilisateur).
// expiresAt court (quelques minutes) : une session USSD réelle dure < 90s
// (DAT §Performance) — une session expirée est traitée comme neuve, jamais
// une erreur (voir ussd-session.service.ts).
model UssdSession {
  id             String   @id @default(uuid())
  sessionId      String   @unique @map("session_id")
  phone          String
  state          String   @default("root")
  // Données accumulées entre étapes (montant saisi, customerId choisi...) —
  // Json plutôt que des colonnes dédiées : la forme dépend de l'étape courante,
  // jamais la même pour "émettre" que pour "payer".
  contextData    Json?    @map("context_data")
  // Peuplés après authentification (tâche ussd-pin-auth) — nullable ici,
  // aucune requête authentifiée construite dans cette tâche.
  userId         String?  @map("user_id")
  organizationId String?  @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  // J3 — index du prédicat de purge (RetentionService).
  @@index([expiresAt])
  @@map("ussd_session")
}

// J2, ADR-116 — registre des demandes de droits des personnes (L/2016/037).
// Preuve de responsabilité (accountability) opposable au régulateur PDP : toute
// opération d'accès OU d'anonymisation écrit une ligne ici.
// APPEND-ONLY en base (trigger data_rights_request_append_only, copie du pattern
// invoice_event / J1) : UPDATE et DELETE rejetés (restrict_violation).
// subjectPhoneHash = HMAC-SHA256(pepper, msisdn normalisé) — non réversible sans
// le secret ; jamais le numéro en clair (voir le commentaire du champ).
// organizationId nullable : le chemin ops plateforme traite des demandes
// transverses (viaOps = true, requestedByUserId = null) → table CROSS-ORG, hors
// RLS (comme merkle_anchor_batch / payment_webhook, cf. rls-rollout.md).
model DataRightsRequest {
  id                 String                    @id @default(uuid())
  kind               DataRightsRequestKind
  outcome            DataRightsRequestOutcome
  // HMAC-SHA256(pepper, msisdn normalisé), hex — JAMAIS le numéro en clair.
  // Nullable : une anonymisation rejouée sur un client déjà anonymisé n'a plus
  // de téléphone à hacher (no-op idempotent). Jamais de chaîne sentinelle.
  subjectPhoneHash   String?                   @map("subject_phone_hash")
  // null = déclenché par l'ops plateforme (clé interne), pas un utilisateur.
  requestedByUserId  String?                   @map("requested_by_user_id")
  viaOps             Boolean                   @default(false) @map("via_ops")
  // null = demande transverse (toutes organisations) via le chemin ops.
  organizationId     String?                   @map("organization_id")
  affectedCustomerIds String[]                 @map("affected_customer_ids")
  note               String?
  createdAt          DateTime                  @default(now()) @map("created_at")

  @@index([subjectPhoneHash])
  @@map("data_rights_request")
}

enum DataRightsRequestKind {
  access
  anonymization
}

enum DataRightsRequestOutcome {
  completed
  partial
  failed
}

// Lot rapprochement bancaire (ADR-052, ADR-117 provisoire) — une ligne de relevé
// bancaire importée (virement ENTRANT uniquement, amountCentimes > 0) et son
// état de rapprochement. La PWA parse le fichier bancaire (CSV/OFX/MT940) et
// pousse un tableau JSON ; le backend ne parse aucun fichier.
//
// Colonnes d'IDENTITÉ (organizationId, importBatchId, valueDate, amountCentimes,
// rawLabel, fingerprint, importedByUserId, createdAt) IMMUABLES en base : trigger
// bank_transaction_identity_immutable (pattern J1/E1). DELETE interdit (même
// trigger). Les colonnes d'ÉTAT (state, matchedInvoiceId, matchedPaymentId,
// resolvedByUserId, resolvedAt, counterpartyLabel, bankRef) restent mutables :
// unmatched → matched | ignored, jamais l'inverse dans ce lot.
//
// CHECK bank_transaction_state_consistency : unmatched ⟺ aucun résolveur ;
// matched ⟺ matchedInvoiceId renseigné ; matchedPaymentId renseigné ⟹ matched.
// CHECK bank_transaction_amount_positive : virements ENTRANTS uniquement.
//
// fingerprint = SHA-256(organizationId ‖ valueDate ISO date ‖ amountCentimes ‖
// rawLabel normalisé), @unique → ré-importer le même relevé ne crée pas de
// doublons. Table scopée organisation → politique RLS standard (pas
// cross-org comme merkle_anchor_batch).
model BankTransaction {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  // Regroupe les lignes d'un même import (affichage + audit). Simple texte —
  // pas d'agrégat BankStatementImport dans ce lot (fast-follow).
  importBatchId     String               @map("import_batch_id")
  // Date de valeur, jamais l'heure (@db.Date) — c'est la granularité des
  // relevés bancaires guinéens et ce qui entre dans l'empreinte.
  valueDate         DateTime             @map("value_date") @db.Date
  // Centimes GNF, toujours positif : virements ENTRANTS seulement.
  amountCentimes    BigInt               @map("amount_centimes")
  // Libellé brut du relevé — peut contenir nom / NIF / IBAN du donneur d'ordre.
  // Jamais loggé, scopé à l'organisation (RLS).
  rawLabel          String               @map("raw_label")
  counterpartyLabel String?              @map("counterparty_label")
  bankRef           String?              @map("bank_ref")
  fingerprint       String               @unique
  state             BankTransactionState @default(unmatched)
  matchedInvoiceId  String?              @map("matched_invoice_id")
  // @unique : une transaction ne produit qu'un Payment, un Payment n'est
  // rapproché qu'une fois. Posé seulement après succès de recordBankTransferPayment.
  matchedPaymentId  String?              @unique @map("matched_payment_id")
  importedByUserId  String               @map("imported_by_user_id")
  resolvedByUserId  String?              @map("resolved_by_user_id")
  resolvedAt        DateTime?            @map("resolved_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  // onDelete: Restrict partout — ni organisation, ni facture, ni paiement, ni
  // utilisateur impliqué dans un rapprochement ne se supprime (registre financier).
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchedInvoice Invoice?     @relation(fields: [matchedInvoiceId], references: [id], onDelete: Restrict)
  matchedPayment Payment?     @relation(fields: [matchedPaymentId], references: [id], onDelete: Restrict)
  importedBy     User         @relation("BankTransactionImporter", fields: [importedByUserId], references: [id], onDelete: Restrict)
  resolvedBy     User?        @relation("BankTransactionResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, state])
  @@map("bank_transaction")
}

enum BankTransactionState {
  unmatched
  matched
  ignored
}

// ADR-107 — Passerelle PDP (Plateforme de Dématérialisation Partenaire) : point
// d'entrée des ERP tiers (Odoo, OwoDesk) qui délèguent à facture.gn la
// certification et la transmission fiscale de leurs documents.
//
// TABLE TAMPON *ET* REGISTRE D'IDEMPOTENCE. Les deux rôles tiennent dans la même
// table à dessein, et c'est le point à comprendre avant de la lire :
//
//   • tampon — le flux e-reporting (B2C, caisses) n'a pas vocation à produire une
//     facture unitaire. Ses lignes attendent ici qu'un cron les compile en Z de
//     caisse global pour la DGI. C'est ce cas d'usage qui a fait naître la table.
//   • registre — @@unique([organizationId, clientUniqueId]) est la SEULE barrière
//     qui empêche un connecteur ERP de faire certifier deux fois la même facture
//     après un simple timeout réseau. Elle doit donc couvrir AUSSI le flux
//     e-invoicing (B2B/B2G), qui, lui, part en file BullMQ. Un e-invoicing qui ne
//     s'inscrirait pas ici n'aurait aucune idempotence durable : la déduplication
//     BullMQ par jobId ne vit que dans Redis, disparaît au nettoyage des jobs
//     terminés (removeOnComplete) et ne survit pas à un flush.
//
// Autrement dit : TOUT document entrant s'inscrit ici, et `flow` décide seulement
// de ce qui se passe ensuite.
//
// `payload` (Json) conserve le corps ERP tel que reçu, jamais retouché. C'est la
// pièce à produire quand un client conteste ce que son ERP a réellement envoyé —
// les colonnes typées n'en sont qu'une projection.
model PdpRawTransaction {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  // Identifiant de la facture DANS l'ERP tiers (ex. « INV/2026/00042 » côté Odoo).
  // Opaque : recopié tel quel, jamais interprété, jamais supposé unique hors de
  // l'organisation qui l'émet — deux PME peuvent parfaitement envoyer « FA-001 ».
  clientUniqueId String @map("client_unique_id")

  flow   PdpFlow
  status PdpTransactionStatus @default(pending)

  // Montants en centimes GNF (ADR-014), convertis depuis les chaînes numériques
  // du payload — jamais par un flottant intermédiaire (voir pdp-amounts.ts).
  totalHtCentimes  BigInt @map("total_ht_centimes")
  totalVatCentimes BigInt @map("total_vat_centimes")
  totalTtcCentimes BigInt @map("total_ttc_centimes")

  payload Json

  apiKeyId String @map("api_key_id")

  // invoiceId est posé par le worker e-invoicing DÈS LA CRÉATION DU BROUILLON,
  // dans la même transaction — pas à la certification. C'est l'ancre
  // d'idempotence du worker : un crash entre la création et l'émission laisserait
  // sinon un brouillon orphelin invisible, et le rejeu du job émettrait DEUX
  // factures certifiées pour un seul document ERP. Au rejeu, le lien déjà présent
  // fait reprendre la facture existante (PdpConsolidationService.emettre).
  // certificationId, lui, n'arrive qu'à l'émission réussie.
  // @unique sur invoiceId : une facture ne répond QUE d'un document ERP — la base
  // refuse qu'un second dépôt s'accroche à la même.
  invoiceId       String? @unique @map("invoice_id")
  certificationId String? @map("certification_id")

  // En clair, quand status = failed. Null partout ailleurs.
  failureReason String? @map("failure_reason")

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // L'index d'idempotence. Composite avec organizationId, jamais un @unique seul
  // sur clientUniqueId : ce dernier interdirait à deux PME d'utiliser la même
  // numérotation ERP, ce qui est le cas NORMAL (même précédent qu'Invoice.number,
  // @@unique([organizationId, number])).
  @@unique([organizationId, clientUniqueId])
  // Le cron de compilation du Z de caisse : « les lignes e-reporting encore
  // pending de cette organisation ». Composite dans cet ordre — RLS filtre
  // d'abord sur organization_id.
  @@index([organizationId, flow, status])
  @@map("pdp_raw_transaction")
}

// b2b / b2g → une facture unitaire, certifiée puis transmise à la DGI.
// b2c → une micro-vente, agrégée en Z de caisse. Le mot « flux » du cahier des
// charges recouvre les deux : c'est cette colonne qui les sépare.
enum PdpFlow {
  e_invoicing
  e_reporting
}

// pending = déposé, pas encore traité — état de TOUTE ligne à l'insertion, quel
// que soit le flux. certified = facture émise et certifiée (e-invoicing) ou ligne
// intégrée à un Z de caisse (e-reporting). failed = abandon définitif,
// failureReason renseignée.
enum PdpTransactionStatus {
  pending
  certified
  failed
}
