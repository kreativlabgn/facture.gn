// Schéma Prisma — Trust Context (bootstrap)
//
// Périmètre volontairement réduit aux 6 entités MVP nécessaires au cycle de vie
// facture minimal : user, user_phone, organization, invoice, invoice_line, invoice_event.
// Référence : Desktop/facture.gn/V/ERD-facture-gn.md (26/07/2026).
//
// Divergences assumées vis-à-vis de l'ERD complet (27 entités) :
// - branch_id, customer_id, product_id, recurring_template_id, financed_by_partner_id
//   sur INVOICE / INVOICE_LINE sont des colonnes scalaires SANS relation FK tant que
//   BRANCH, CUSTOMER, PRODUCT, RECURRING_INVOICE_TEMPLATE, FINANCIAL_PARTNER n'existent pas.
// - InvoiceSequence est un ajout (absent de l'ERD) pour garantir number sans trou
//   par organisation/année sous concurrence (voir Registre-ADR, Article 23 OHADA).
// - Colonnes en snake_case en base (@map), camelCase côté client Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredLanguage {
  fr
  pular
  malinke
  soussou
}

enum RegimeFiscal {
  normal_tva
  tpu
  normal_sans_tva
  non_assujetti_association
}

enum LegalForm {
  commercial
  association
}

enum RegistrationSource {
  organic
  apip
  cga_referral
  fodip
  partner_3ae
}

enum DgiVerificationStatus {
  unverified
  pending
  verified
}

enum CommercialTier {
  freemium
  starter
  pro
  enterprise
  custom
}

enum InvoiceDocumentType {
  invoice
  proforma
  quote
}

// Une seule valeur aujourd'hui (C5) — enum plutôt que String brute pour rester
// cohérent avec tous les autres champs discriminants de ce schema (RegimeFiscal,
// InvoiceDocumentType, InvoiceStatus, PaymentMethod), et pour qu'une future
// distinction arrhes/acompte (mentionnée par ADR-034, non construite ici) ne puisse
// pas introduire une valeur mal orthographiée qui échapperait silencieusement aux
// filtres depositType="arrhes" déjà en place.
enum DepositType {
  arrhes
}

// 7 valeurs — DAT §4 : invoice.status
enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  voided
  converted
  expired
}

enum DisputeStatus {
  none
  disputed
  resolved
}

// 22 types confirmés au périmètre MVP/V1 (DAT §4.1 / ERD note de lecture).
// Les types V2 (liquidation_validated, service_fait_confirmed, financing_disbursed)
// sont volontairement exclus tant que le B2G Context n'est pas scaffoldé.
// cash pour C1 (ce plan) ; payment_link (C2, orchestrateur Djomy/Moneroo) et
// bank_transfer (C3) sont des stories séparées — l'enum couvre les 3 valeurs de
// l'ERD par cohérence long terme, mais seul "cash" est accepté par le DTO/service
// actuel (docs/plans/2026-08-08-cash-payment-with-proof.md).
enum PaymentMethod {
  cash
  payment_link
  bank_transfer
}

enum PaymentStatus {
  pending
  completed
  failed
}

enum InvoiceEventType {
  cancellation_indemnity
  no_show_forfeited
  dispute_raised
  dispute_resolved
  payment_reminder_sent
  payment_link_generated
  payment_link_expired
  payment_link_regenerated
  invoice_voided
  invoice_converted
  overpayment_recorded
  refund_issued
  suspicious_cash_pattern_detected
  stale_invoice_detected
  mandate_requested
  mandate_granted
  mandate_revoked
  mandate_expired
  revenue_share_credited
  regime_change
  delegated_key_tier_changed
  validation_revoked
}

model User {
  id                 String            @id @default(uuid())
  name               String
  passwordHash       String?           @map("password_hash")
  preferredLanguage  PreferredLanguage @default(fr) @map("preferred_language")
  createdAt          DateTime          @default(now()) @map("created_at")

  // ADR-045, B5 — flag plateforme, indépendant de tout OrganizationRole (les 7 rôles
  // existants sont tous scopés à une organisation). Accordé exclusivement via un
  // endpoint interne dédié (FieldAgentAuthGuard, secret propre — jamais confondu
  // avec MONEY_API_INTERNAL_KEY ni DGI_VERIFICATION_INTERNAL_KEY).
  isFieldAgent Boolean @default(false) @map("is_field_agent")

  phones        UserPhone[]
  invoiceEvents InvoiceEvent[]
  memberships   OrganizationMember[]
  recoveryRequestsMade     AccountRecoveryRequest[] @relation("RecoveryRequester")
  recoveryRequestsResolved AccountRecoveryRequest[] @relation("RecoveryResolver")
  assistedSessions         AssistedSession[]

  @@map("user")
}

// 7 rôles organisationnels de base (ADR-027, MVP initial). accountant_external et
// practice_admin (portant le MVP à 9, ADR-070) ne sont volontairement pas inclus ici :
// ils dépendent du mécanisme de mandat cabinet/CGA (PROFESSIONAL_PRACTICE/MANDATE)
// non scaffoldé — voir docs/plans/2026-08-08-auth-rbac-org-roles.md.
enum OrganizationRole {
  owner
  admin
  accountant_internal
  cashier
  field_agent
  delivery_driver
  client_portal
}

// Le rôle n'est jamais mis en cache dans le JWT (voir AuthTokenService) : toujours
// résolu ici à la requête, pour qu'une révocation (revokedAt) soit effective
// immédiatement plutôt qu'à l'expiration du token.
model OrganizationMember {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  userId         String            @map("user_id")
  role           OrganizationRole
  createdAt      DateTime          @default(now()) @map("created_at")
  revokedAt      DateTime?         @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_member")
}

model UserPhone {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  msisdn     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_phone")
}

enum RecoveryStatus {
  pending
  approved
  rejected
}

// ADR-042, B3 — "backup admin obligatoire" est un nudge, jamais un blocage
// (cohérent avec B1/B4, inscription jamais bloquée) : aucun champ de désignation
// dédié, n'importe quel OrganizationMember owner/admin non révoqué de
// l'organisation ciblée joue ce rôle au moment de la résolution.
model AccountRecoveryRequest {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  status         RecoveryStatus @default(pending)
  requestedAt    DateTime       @default(now()) @map("requested_at")
  resolvedAt     DateTime?      @map("resolved_at")
  resolvedByUserId String?      @map("resolved_by_user_id")

  user           User          @relation("RecoveryRequester", fields: [userId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  resolvedByUser User?         @relation("RecoveryResolver", fields: [resolvedByUserId], references: [id])

  @@map("account_recovery_request")
}

model Organization {
  id                          String                 @id @default(uuid())
  name                        String
  regimeFiscal                RegimeFiscal           @map("regime_fiscal")
  legalForm                   LegalForm              @map("legal_form")
  // Nullable : NIF optionnel à l'inscription (ADR-035, story B4 — self-service
  // jamais bloqué par une information que la PME n'a pas encore). Plusieurs
  // organisations sans NIF n'entrent jamais en conflit : Postgres autorise
  // plusieurs NULL sur une colonne @unique (même pattern qu'Invoice.number).
  nif                         String?                @unique
  etaxNumber                  String?                @map("etax_number")
  rccm                        String?
  registrationSource          RegistrationSource     @default(organic) @map("registration_source")
  dgiVerificationStatus       DgiVerificationStatus  @default(unverified) @map("dgi_verification_status")
  bankAccountDetails          Json?                  @map("bank_account_details")
  preferredLanguage           PreferredLanguage      @default(fr) @map("preferred_language")
  chiffreAffairesBrutDeclare  BigInt                 @default(0) @map("chiffre_affaires_brut_declare")
  paymentLinkAutoSend         Boolean                @default(true) @map("payment_link_auto_send")
  commercialTier              CommercialTier         @default(freemium) @map("commercial_tier")
  createdAt                   DateTime               @default(now()) @map("created_at")
  // Nullable : seules les organisations inscrites via le Chemin B (assisté, B5)
  // en ont un — ADR-046/047, 8 caractères Base32, vérification de collision à la
  // génération (voir organizations.service.ts:createAssisted).
  accountCode                 String?                @unique @map("account_code")

  invoices          Invoice[]
  sequences         InvoiceSequence[]
  members           OrganizationMember[]
  recoveryRequests  AccountRecoveryRequest[]
  assistedSessions  AssistedSession[]

  @@map("organization")
}

// ADR-045, B5 — trace de l'inscription assistée. Jamais de membership pour l'agent
// terrain lui-même (fieldAgentUserId n'est PAS dans OrganizationMember) : cette
// table EST la seule preuve du lien agent↔organisation. consentRecordedAt (jamais
// un booléen simple) — horodatage du consentement explicitement recueilli, cohérent
// avec le reste du schema (resolvedAt, revokedAt...).
model AssistedSession {
  id                String   @id @default(uuid())
  fieldAgentUserId  String   @map("field_agent_user_id")
  organizationId    String   @map("organization_id")
  consentRecordedAt DateTime @map("consent_recorded_at")
  createdAt         DateTime @default(now()) @map("created_at")

  fieldAgent   User         @relation(fields: [fieldAgentUserId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("assisted_session")
}

// Compteur atomique par organisation/année — support de la numérotation
// séquentielle sans trou (OHADA Article 23). Absent de l'ERD de référence,
// ajouté pour rendre l'invariant applicable sous concurrence (cf. PLAN Tâche 10).
model InvoiceSequence {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  year           Int
  lastNumber     Int    @default(0) @map("last_number")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year])
  @@map("invoice_sequence")
}

model Invoice {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  branchId       String? @map("branch_id")
  customerId     String? @map("customer_id")

  // FG-YYYY-NNNNNN — séquentiel légal OHADA Article 23, unique par organisation
  // (ERD ligne 208), pas globalement : deux organisations différentes émettent
  // chacune leur propre séquence à partir de 1 (voir @@unique([organizationId,
  // number]) plus bas — jamais un @unique seul sur ce champ).
  // Nullable tant que draft : le numéro n'est consommé qu'à l'émission (issue),
  // jamais à la création du brouillon — sinon un brouillon abandonné créerait un trou.
  number String?

  // GN-{NIF8}-{YYYY}-{HASH6} — vérification publique, non-séquentiel.
  // Nullable tant que la facture n'est pas issued (pas de draft certifié).
  certificationId String? @unique @map("certification_id")

  documentType InvoiceDocumentType @default(invoice) @map("document_type")
  status       InvoiceStatus       @default(draft)
  disputeStatus DisputeStatus      @default(none) @map("dispute_status")

  validatedByAdministration Boolean @default(false) @map("validated_by_administration")

  totalHt  BigInt @default(0) @map("total_ht")
  totalTva BigInt @default(0) @map("total_tva")
  totalTtc BigInt @default(0) @map("total_ttc")

  discountPct Int @default(0) @map("discount_pct")

  amountPaid        BigInt @default(0) @map("amount_paid")
  amountDue         BigInt @default(0) @map("amount_due")
  overpaymentAmount BigInt @default(0) @map("overpayment_amount")

  paymentLinkUrl       String?   @map("payment_link_url")
  paymentLinkId        String?   @map("payment_link_id")
  paymentLinkExpiresAt DateTime? @map("payment_link_expires_at")

  referenceCurrency String?   @map("reference_currency")
  referenceAmount   BigInt?   @map("reference_amount")
  fxRate            Decimal?  @map("fx_rate")
  fxRateDate        DateTime? @map("fx_rate_date")

  recurringTemplateId  String? @map("recurring_template_id")
  convertedToInvoiceId String? @unique @map("converted_to_invoice_id")

  quoteValidUntil DateTime? @map("quote_valid_until")
  referenceMarche String?   @map("reference_marche")

  financedByPartnerId String?   @map("financed_by_partner_id")
  financedAt          DateTime? @map("financed_at")

  hash         String?
  previousHash String? @map("previous_hash")
  signature    Bytes?

  issuedAt  DateTime? @map("issued_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization      Organization   @relation(fields: [organizationId], references: [id])
  convertedFrom     Invoice?       @relation("InvoiceConversion", fields: [convertedToInvoiceId], references: [id])
  convertedInto     Invoice[]      @relation("InvoiceConversion")
  lines             InvoiceLine[]
  events            InvoiceEvent[]
  payments          Payment[]
  creditNotes       CreditNote[]
  refunds           Refund[]

  @@unique([organizationId, number])
  @@map("invoice")
}

model Payment {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  // centimes GNF — ce que le marchand reçoit pour un règlement normal (depositType
  // null) ; pour une arrhes (depositType=arrhes, C5), le montant du dépôt de
  // sécurité lui-même, jamais appliqué au solde de la facture (Invoice.amountPaid/
  // amountDue) — deux significations distinctes de la même colonne, jamais mélangées
  // par les chemins d'écriture (recordCashPayment/recordProviderPayment vs
  // recordDepositPayment).
  amount            BigInt @map("amount")
  amountCollected   BigInt @map("amount_collected") // centimes GNF — ce que le payeur a payé
  platformFeeAmount BigInt @default(0) @map("platform_fee_amount")
  gatewayFeeAmount  BigInt @default(0) @map("gateway_fee_amount")

  method             PaymentMethod  @default(cash)
  providerSubMethod  String?        @map("provider_sub_method")
  depositType        DepositType?   @map("deposit_type")
  providerRef        String?        @map("provider_ref")
  status             PaymentStatus  @default(pending)

  // Contrainte unique = mécanisme d'idempotence (header Idempotency-Key, ADR-016) —
  // pas de Redis dans ce repo, un replay renvoie ce paiement plutôt que d'en recréer un.
  idempotencyKey String @unique @map("idempotency_key")

  // Preuve obligatoire au-delà de cash_proof_threshold_gnf (DAT §config, 1M GNF) —
  // référence à un objet déjà uploadé côté client (MinIO WORM hors scope de ce plan,
  // pas encore scaffoldé dans ce repo), jamais de gestion d'upload ici.
  proofPhotoUrl   String? @map("proof_photo_url")
  proofGpsLat     Float?  @map("proof_gps_lat")
  proofGpsLng     Float?  @map("proof_gps_lng")
  proofSignature  String? @map("proof_signature")

  collectedAt DateTime @default(now()) @map("collected_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payment")
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  productId String? @map("product_id")

  description String
  quantity    Int
  unitPrice   BigInt @map("unit_price")
  taxRateBps  Int    @default(0) @map("tax_rate_bps")

  costPriceAtTime BigInt? @map("cost_price_at_time")

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  creditNoteLines CreditNoteLine[]

  @@map("invoice_line")
}

// ADR-040, C7 — mécanisme de correction d'une facture déjà émise, jamais une
// mutation directe (Invoice reste immuable après issue()). amount est un total
// unique (pas de ventilation HT/TVA par ligne, cf. ERD) calculé côté serveur à
// l'émission — jamais une valeur de confiance du client (même principe que
// taxRateBps, C4). N'affecte JAMAIS Invoice.totalTtc/amountDue/amountPaid : bucket
// financier délibérément séparé, même précédent que les arrhes (Payment.depositType
// = "arrhes", C5). refundMultiplier (1 ou 2) référence ADR-034 (arrhes + annulation
// professionnelle) sans intégration avec forfeitDeposit() à ce stade.
model CreditNote {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  amount           BigInt // centimes GNF
  refundMultiplier Int      @default(1) @map("refund_multiplier")
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]
  refunds Refund[]

  @@map("credit_note")
}

// quantity_returned est une QUANTITÉ, pas un montant (cf. ERD) — la trace du
// "niveau ligne" d'ADR-040 sert à savoir quelles lignes et combien d'unités ont été
// créditées, la ventilation monétaire reste un total unique sur CreditNote.amount.
model CreditNoteLine {
  id               String @id @default(uuid())
  creditNoteId     String @map("credit_note_id")
  invoiceLineId    String @map("invoice_line_id")
  quantityReturned Int    @map("quantity_returned")

  creditNote  CreditNote  @relation(fields: [creditNoteId], references: [id])
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])

  @@map("credit_note_line")
}

enum RefundMethod {
  cash
  payment_link_payout
  bank_transfer
  credit_on_account
}

enum RefundStatus {
  pending
  completed
  failed
}

// ADR-063, C13 — "credit_note = document comptable. refund = mouvement d'argent."
// Deux faits distincts, jamais confondus : CreditNote peut exister sans jamais être
// remboursé (crédit conservé côté client). payment_link_payout (Djomy Payout,
// fallback Moneroo) est créé "pending" — aucune exécution ni confirmation
// automatique construite ici (V2, ADR-089/FINANCIAL_PARTNER, aucune intégration
// Money Context payout n'existe dans ce repo). cash/bank_transfer/credit_on_account
// sont des attestations immédiates du staff (même principe que
// recordCashPayment()/recordBankTransferPayment(), C1/C3) : "completed" dès la
// création, jamais "pending".
model Refund {
  id          String       @id @default(uuid())
  creditNoteId String      @map("credit_note_id")
  invoiceId   String       @map("invoice_id")
  amount      BigInt // centimes GNF
  method      RefundMethod
  providerRef String?      @map("provider_ref")
  status      RefundStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")
  completedAt DateTime?    @map("completed_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  invoice    Invoice    @relation(fields: [invoiceId], references: [id])

  @@map("refund")
}

model InvoiceEvent {
  id        String           @id @default(uuid())
  invoiceId String           @map("invoice_id")
  type      InvoiceEventType
  actorId   String?          @map("actor_id")
  amount    BigInt?
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])

  @@map("invoice_event")
}

// ===== Money Context (Squad Money) — orchestrateur de paiement =====
// Périmètre C2 Phase 1 (docs/plans/2026-08-08-money-context-payment-orchestrator.md) :
// traçabilité par tentative de paiement (ADR-076) uniquement. PAYMENT_WEBHOOKS
// (ADR-075) et le câblage sur invoices.service.ts.issue() sont une Phase 2 séparée.

enum PaymentProviderName {
  djomy
  moneroo
  orange_direct
  mtn_direct
}

enum PaymentProviderAttemptStatus {
  pending
  success
  failed
  timeout
}

// Propriété d'écriture exclusive de money-api (Trust Context ne modifie jamais
// cette table) — même base Postgres partagée via packages/db, bounded contexts
// séparés au niveau applicatif, pas au niveau base de données pour ce MVP.
model PaymentProviderAttempt {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  provider PaymentProviderName
  status   PaymentProviderAttemptStatus @default(pending)

  providerRef String? @map("provider_ref")
  amountGnf   BigInt  @map("amount_gnf")
  feeGateway  BigInt  @default(0) @map("fee_gateway")
  feePlatform BigInt  @default(0) @map("fee_platform")

  createdAt DateTime  @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")

  @@map("payment_provider_attempt")
}

enum WebhookNormalizedStatus {
  paid
  failed
  pending
}

// ADR-075 — un webhook n'est inséré qu'APRÈS traitement complet réussi (jamais un
// état à moitié traité) : @@unique([provider, providerRef]) sert de garde de
// dédoublonnage ET de preuve d'auditabilité complète. Propriété exclusive de
// money-api, même raisonnement que PaymentProviderAttempt.
model PaymentWebhook {
  id String @id @default(uuid())

  provider    PaymentProviderName
  providerRef String              @map("provider_ref")

  payload          Json
  normalizedStatus WebhookNormalizedStatus @map("normalized_status")
  signatureValid   Boolean                 @map("signature_valid")

  processedAt DateTime @default(now()) @map("processed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([provider, providerRef])
  @@map("payment_webhook")
}
