// Vague 0 (C1) — gate d'audit des dépendances, exécuté en CI (job `security`).
// Bloque le merge sur toute vulnérabilité HIGH ou CRITICAL non explicitement
// tolérée ci-dessous. Les MODERATE/LOW sont rapportées mais non bloquantes pour
// l'instant (ratchet dans une vague ultérieure).
//
// Chaque entrée de `allowlist` DOIT être justifiée par un commentaire : soit la
// dépendance est purement dev/build-time (jamais dans le bundle runtime des
// services déployés), soit le vecteur d'attaque n'est pas atteignable. À revoir
// à chaque PR Dependabot — l'objectif est que cette liste se vide.
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "pnpm": true,
  "high": true,
  "moderate": false,
  "low": false,
  "report-type": "summary",
  "allowlist": [
    // glob CLI command injection — tiré par @nestjs/cli (devDependency). Le CLI
    // `glob` n'est jamais invoqué. Corrigé dès que @nestjs/cli le remonte.
    "GHSA-5j98-mcp5-4vw2",
    // picomatch ReDoS — @nestjs/cli > @angular-devkit (dev, build de schematics).
    "GHSA-c2c7-rcm5-vvqj",
    // tmp path traversal — @nestjs/cli > inquirer > external-editor (dev, prompt CLI).
    "GHSA-ph9p-34f9-6g65",
    // vite server.fs.deny bypass — vitest (dev). Aucun serveur de dev Vite exposé.
    "GHSA-fx2h-pf6j-xcff",
    // nanoid boucle infinie sur size=0 — tiré par postcss (build-time : next et
    // webpack/@nestjs/cli). Jamais atteint au runtime des services NestJS.
    "GHSA-2v37-7h3g-55p8",
    // vitest UI arbitrary file read — le mode UI (`vitest --ui`) n'est jamais lancé.
    "GHSA-5xrq-8626-4rwp",
    // fast-uri SSRF / host confusion (4 avis, publiés 02/09/2026) — chaîne
    // @nestjs/cli > webpack > terser-webpack-plugin > schema-utils > ajv > fast-uri
    // (devDependency, build-time). `ajv` n'utilise `fast-uri` que pour résoudre
    // les `$ref`/`$id` de schémas JSON STATIQUES (options de loaders webpack) —
    // jamais d'URL contrôlée par un tiers, aucune requête réseau dérivée.
    "GHSA-jqff-g426-hqxp",
    "GHSA-f65p-4m7j-42xc",
    // @nestjs/cli > glob — devDependency, le CLI glob n'est jamais invoqué en prod.
    "GHSA-fph4-wmhf-6fwf",
    // @nestjs/cli > inquirer > external-editor — devDependency, prompt CLI.
    "GHSA-5jgf-p345-68v8",
    // vitest UI arbitrary file read — le mode UI n'est jamais lancé.
    // browserslist crash/prototype-write + OOM (publiés 01/09/2026) — chaîne
    // apps/web > @serwist/next > browserslist. `browserslist` tourne au BUILD
    // (résolution des cibles pour le bundle SW), jamais sous `next start`. Les
    // deux vecteurs exigent un `browserslist-stats.json` non fiable ou des
    // requêtes pathologiques — la config est statique et in-repo.
    "GHSA-73wf-gq98-2v4g",
    "GHSA-c83g-rgw3-j3cx"
  ]
}
