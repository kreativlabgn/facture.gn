# Server-only (jamais NEXT_PUBLIC_) — le fetch vers trust-api se fait
# exclusivement côté serveur (Server Component), le navigateur ne voit jamais
# cette URL.
TRUST_API_URL="http://localhost:3000"

# Money Context (checkout public /pay/[invoiceId]). MONEY_API_URL sert au
# récapitulatif public, MONEY_API_INTERNAL_KEY au seul débit Mobile Money —
# c'est la MÊME valeur que celle de money-api, la route /charge la vérifie en
# temps constant. Server-only elle aussi : un préfixe NEXT_PUBLIC_ la publierait
# dans le bundle et ouvrirait le débit à tout le monde.
MONEY_API_URL="http://localhost:3001"
MONEY_API_INTERNAL_KEY=""

# Signature des jetons de session de checkout (cookie fg_pay, 15 min, lié à une
# facture). 32 caractères minimum, sinon le checkout refuse de signer et le
# paiement reste fermé : openssl rand -hex 32
# À NE PAS CONFONDRE avec fg_portal, la session OTP du portail acheteur, qui
# n'utilise pas ce secret et n'est pas concernée.
PAY_SESSION_SECRET=""
