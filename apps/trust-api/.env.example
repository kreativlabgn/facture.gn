DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"

# Connexion directe pour le CLI Prisma (`migrate`) — schema.prisma déclare
# `directUrl = env("DIRECT_URL")`. En local / CI : identique à DATABASE_URL.
# En prod (ADR-120) : DATABASE_URL = pooler Supabase transaction (port 6543,
# ?pgbouncer=true) ; DIRECT_URL = connexion directe Supabase (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"

# JWT RS256 (ADR-011). Générer une paire de dev avec :
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_PRIVATE_KEY=\"'+privateKey.replace(/\n/g,'\\\\n')+'\"');console.log('JWT_PUBLIC_KEY=\"'+publicKey.replace(/\n/g,'\\\\n')+'\"');"
# Jamais la même paire en dev et en prod. TODO(ADR-008) : Vault Transit en prod.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExAMPLE...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBExAMPLE...\n-----END PUBLIC KEY-----\n"

# Clé racine Ed25519 de certification (hex, 32 octets). Sans cette variable, une
# nouvelle clé aléatoire serait générée à chaque démarrage et GET /verify échouerait
# pour toute facture émise avant le redémarrage (ADR-026/A3 : HSM cloud en prod).
# Générer une clé de dev avec :
#   node -e "const{randomBytes}=require('crypto');console.log('CERTIFICATION_PRIVATE_KEY=\"'+randomBytes(32).toString('hex')+'\"');"
CERTIFICATION_PRIVATE_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Money Context (C2 Phase 2a) — génération du lien de paiement à l'émission,
# jamais bloquant (issue() réussit même si money-api est indisponible).
# MONEY_API_INTERNAL_KEY doit être la MÊME valeur que côté apps/money-api/.env —
# une seule génération, pas deux valeurs indépendantes :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONEY_API_URL="http://localhost:3001"
MONEY_API_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Déclenche POST /organizations/:id/verify-dgi (B2) — "en tant que système" dans le
# backlog, jamais un rôle organisationnel. Secret STRICTEMENT distinct de
# MONEY_API_INTERNAL_KEY ci-dessus : périmètre de confiance différent (backoffice/
# futur processus de vérification DGI vs. money-api). Même commande de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DGI_VERIFICATION_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Déclenche POST /auth/field-agents/:userId/grant (B5) — octroi machine-à-machine du
# statut agent terrain plateforme (Chemin B, ADR-045). Secret STRICTEMENT distinct de
# MONEY_API_INTERNAL_KEY et DGI_VERIFICATION_INTERNAL_KEY — périmètre de confiance
# propre, à ne jamais réutiliser. Même commande de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMERCIAL_AGENT_GRANT_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Déclenche POST /organizations/:id/commission-bypass-cases et POST
# /commission-bypass-cases/:id/resolve (G3, ADR-091) — outil interne Squad
# Money, jamais un rôle organisationnel. Secret STRICTEMENT distinct des autres
# clés inter-service ci-dessus — périmètre de confiance propre. Même commande
# de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COMMISSION_BYPASS_REVIEW_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# J2, ADR-116 — chemin ops plateforme des droits des personnes (L/2016/037) :
# POST /internal/data-rights/export et /anonymize, portée TRANSVERSE (une demande
# d'un particulier peut couvrir plusieurs organisations). Secret STRICTEMENT
# distinct des autres clés inter-service. Même commande de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_RIGHTS_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# J2, ADR-116 — pepper HMAC-SHA256 du subject_phone_hash écrit dans
# data_rights_request. Un SHA-256 nu d'un MSISDN guinéen (~10⁹ valeurs) se
# renverse en secondes ; le pepper (hors base) rend le hash non réversible sans
# le secret tout en gardant la corrélation « un sujet = une clé ». Génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_RIGHTS_SUBJECT_HASH_PEPPER="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# A3, ADR-026 — chiffrement enveloppe (AES-256-GCM) protégeant la clé racine
# Ed25519 de CHAQUE organisation au repos (packages/db, OrganizationSigningKey).
# Approximation MVP honnête d'un vrai HSM cloud (aucun SDK Vault/KMS dans ce
# repo) — sans cette clé, toute clé d'organisation déjà chiffrée devient
# indéchiffrable (perte totale de la capacité de signature de la plateforme),
# fail-fast au démarrage. STRICTEMENT distinct de CERTIFICATION_PRIVATE_KEY
# ci-dessus (celle-ci reste la clé UNIQUE GLOBALE légataire, utilisée
# uniquement pour vérifier les factures signées avant cette story — jamais
# pour en signer de nouvelles). Même commande de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERTIFICATION_MASTER_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Sécurise POST /v1/partners/apip/company-created (F11, ADR-082) — sert à la fois
# de clé attendue (header X-Partner-Key) ET de secret HMAC-SHA256 (header
# X-Partner-Signature, calculée sur le corps brut). MVP mono-partenaire (APIP
# seul, ADR-078) — un multi-partenaires réel exigerait une table de clés dédiée,
# hors scope ici. STRICTEMENT distinct des autres secrets internes ci-dessus —
# un partenaire externe (APIP) n'est PAS un service interne facture.gn. Même
# commande de génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIP_WEBHOOK_SECRET="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# Lot H — traces OpenTelemetry (DAT §12). OPT-IN : rien n'est instrumenté sans
# OTEL_TRACES_ENABLED=true ET un endpoint. Un collecteur injoignable ne bloque
# jamais le démarrage ni les requêtes.
OTEL_TRACES_ENABLED="false"
# Endpoint OTLP/HTTP du collecteur. Générique (le path /v1/traces est ajouté) :
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# …ou spécifique aux traces (utilisé tel quel, sans ajout de path) :
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
# En-têtes optionnels (auth du collecteur), format "clé1=valeur1,clé2=valeur2" :
# OTEL_EXPORTER_OTLP_HEADERS="x-api-key=..."
# Ratio de sampling racine [0..1], défaut 1 (tout tracer) :
OTEL_TRACES_SAMPLER_ARG="1"
# Surcharges optionnelles du nom/version de service (défaut : trust-api / 0.0.0) :
# OTEL_SERVICE_NAME="trust-api"
# OTEL_SERVICE_VERSION="0.0.0"

# Lot J3 — file BullMQ (job de rétention). Connexion Redis (lazyConnect : le
# démarrage ne dépend pas de Redis). Partagée avec money-api si même instance.
# EN PROD : rediss:// (TLS) + ACL dédié — un accès Redis contrôle toutes les
# files BullMQ de la plateforme. Voir docs/runbooks/retention.md.
REDIS_URL="redis://localhost:6379"
# Job de purge des tables éphémères (sessions USSD / OTP / tokens révoqués /
# invitations). OPT-IN : armé UNIQUEMENT si RETENTION_ENABLED="true" (c'est un
# DELETE physique irréversible). Toute autre valeur = brique chargée, job non
# armé. Checklist d'activation prod dans docs/runbooks/retention.md.
RETENTION_ENABLED="false"

# Lot E1 — registre Merkle des factures (scellement horaire + flush vers le seam
# d'ancrage). OPT-IN : armé UNIQUEMENT si MERKLE_ANCHOR_ENABLED="true". Sink par
# défaut = Noop (aucun ancrage réel). Voir docs/runbooks/merkle-anchor.md.
MERKLE_ANCHOR_ENABLED="false"

# Chantier 5 — télétransmission au guichet eTax / e-TVA de la DGI. Couvre DEUX
# obligations distinctes, servies par la même file et la même configuration :
# la déclaration de TVA à la clôture d'un exercice, et la transmission UNITAIRE
# de chaque facture à son émission (LFI 2025).
#
# OPT-IN STRICT, comme RETENTION_ENABLED. Le défaut est « ne transmet pas », et
# il faut une décision consciente pour l'activer : une déclaration fiscale ne se
# retire pas, et un environnement de développement qui écrirait chez la DGI
# n'aurait aucun moyen de revenir en arrière.
ETAX_ENABLED="false"
# Base du guichet. Les deux chemins en dérivent : POST {URL}/declarations pour un
# exercice, POST {URL}/invoices pour une facture.
ETAX_API_URL=""
# Sert à signer le corps EXACT transmis (HMAC-SHA256, en-tête X-Etax-Signature).
ETAX_API_KEY=""
