DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"

# Port distinct de trust-api (3000 par défaut) — les deux services tournent en
# parallèle, isolation des pannes (DAT §2).
PORT=3001

# Secret partagé inter-service (trust-api → money-api uniquement, jamais un client
# final). MÊME valeur à copier dans apps/trust-api/.env (MONEY_API_INTERNAL_KEY) —
# une seule génération, pas deux valeurs indépendantes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONEY_API_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# C2 Phase 2b — money-api rappelle trust-api pour confirmer un paiement une fois un
# webhook validé (jamais best-effort, contrairement au sens trust-api→money-api de
# la Phase 2a — voir payment-confirmation-client.ts).
TRUST_API_URL="http://localhost:3000"
