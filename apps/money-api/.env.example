DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facture_gn_dev?schema=public"

# Port distinct de trust-api (3000 par défaut) — les deux services tournent en
# parallèle, isolation des pannes (DAT §2).
PORT=3001

# Secret partagé inter-service (trust-api → money-api uniquement, jamais un client
# final). MÊME valeur à copier dans apps/trust-api/.env (MONEY_API_INTERNAL_KEY) —
# une seule génération, pas deux valeurs indépendantes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONEY_API_INTERNAL_KEY="EXAMPLE0000000000000000000000000000000000000000000000000000000"

# C2 Phase 2b — money-api rappelle trust-api pour confirmer un paiement une fois un
# webhook validé (jamais best-effort, contrairement au sens trust-api→money-api de
# la Phase 2a — voir payment-confirmation-client.ts).
TRUST_API_URL="http://localhost:3000"

# Garde stub sur POST /webhooks/:provider (endpoint PUBLIC — l'authentification
# réelle sera la vérification HMAC/signature de chaque fournisseur, ADR-075, pas
# encore de credentials disponibles). Sans ce secret, provider_ref n'est PAS un
# secret (visible dans l'URL du lien de paiement envoyée au client) : n'importe qui
# pourrait forger un webhook "payé" — trouvé par dev-security-reviewer, C2 Phase 2b.
# Générer une valeur de dev distincte par provider :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DJOMY_WEBHOOK_STUB_SECRET="EXAMPLE0000000000000000000000000000000000000000000000000000000"
MONEROO_WEBHOOK_STUB_SECRET="EXAMPLE1111111111111111111111111111111111111111111111111111111"

# Lot E — BullMQ (worker de réconciliation des paiements). `docker compose up -d`
# fournit un Redis local.
REDIS_URL="redis://localhost:6379"
# false : garde la brique BullMQ sans lancer le worker répétable (déploiement
# progressif, CI, tests). Toute autre valeur (ou absence) = worker actif.
RECONCILIATION_ENABLED="true"
# Ancienneté (minutes) au-delà de laquelle une tentative de paiement pending/
# timeout est vérifiée activement auprès du provider (le webhook nominal a la
# priorité pendant ce délai). Défaut 60.
RECONCILIATION_STALE_MINUTES="60"
